---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TickerCarousel from '../components/ui/TickerCarousel.astro';
import DressCard from '../components/ui/DressCard.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';

// Import Admin Singletons
import tickerData from '../content/settings/ticker.json';
import tiersData from '../content/settings/tiers.json';
import faqsData from '../content/settings/faqs.json';

const PHONE_NUMBER = "01827 946 098";
const PHONE_HREF = "tel:01827946098";

// Query all featured dresses from Decap markdown (Astro 5 uses dress.id)
const allDresses = await getCollection('dresses');
const featuredDresses = allDresses
  .filter((dress) => dress.data.featured)
  .map((dress) => ({
    id: dress.id,
    ...dress.data,
  }));

const consultationTiers = tiersData.tiers;
const homepageFaqs = faqsData.homepageFaqs;
---

<BaseLayout
  title="The Bridal Room Atherstone | Private Luxury Bridal Boutique Warwickshire"
  description="Intimate Warwickshire bridal boutique offering exclusive 1-to-1 bridal appointments. Featuring Justin Alexander, Sincerity, and take-home designer sample gowns."
  faqs={homepageFaqs}
>
  <!-- 1. HERO SECTION -->
  <section class="relative h-[calc(100svh-140px)] lg:h-[calc(100vh-160px)] min-h-125 max-h-180 flex items-center overflow-hidden">
    <img
      src="/images/hero.webp"
      alt="The Bridal Room Atherstone boutique showroom wedding gown collection"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      class="absolute inset-0 w-full h-full object-cover object-[85%_top] sm:object-top"
    />
    <div class="absolute inset-0 bg-linear-to-r from-stone-900/80 via-stone-900/45 to-transparent"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-12 w-full py-8 text-white">
      <div class="max-w-xl">
        <div class="flex items-center gap-3 text-[10px] tracking-[0.35em] text-stone-300 uppercase font-light mb-3">
          <span>Warwickshire Flagship</span>
          <span class="w-8 h-px bg-stone-400"></span>
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-light tracking-wide uppercase leading-tight mb-3">
          Find The Dress
        </h1>
        <p class="font-serif italic text-base sm:text-xl text-stone-200 font-light mb-8 leading-relaxed">
          A considered bridal experience, beautifully personal.
        </p>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="/dresses"
            class="inline-flex items-center justify-center gap-3 border border-white/80 bg-black/30 backdrop-blur-sm px-7 py-3.5 text-xs tracking-[0.2em] uppercase hover:bg-white hover:text-stone-900 transition-all duration-300"
          >
            Explore Lookbook
            <span class="text-sm">→</span>
          </a>
          <a
            href="/the-experience#book"
            class="inline-flex items-center justify-center border border-white/40 px-6 py-3.5 text-xs tracking-[0.2em] uppercase text-white hover:bg-white hover:text-stone-900 transition-all duration-300"
          >
            Book Private Suite
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. REASSURANCE TICKER (Data from ticker.json) -->
  <TickerCarousel items={tickerData.items} />

  <!-- 3. BOUTIQUE EXPERIENCE SECTION -->
  <section class="scroll-mt-24 py-20 sm:py-28 lg:py-32 px-6 lg:px-12 bg-ivory-50">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Text Column -->
      <div class="max-w-lg">
        <div class="flex items-center gap-3 text-[11px] tracking-[0.28em] text-stone-600 uppercase font-light mb-4">
          <span>65 Station Street, Atherstone</span>
          <span class="w-12 h-px bg-stone-400"></span>
        </div>

        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light text-stone-900 leading-tight mb-7">
          A boutique experience,<br />
          <span class="italic font-light">just for you.</span>
        </h2>

        <div class="space-y-5 text-sm sm:text-[15px] leading-relaxed text-stone-600 font-light">
          <p>
            At The Bridal Room, we believe choosing your wedding dress should be as serene and unforgettable as the day itself. Step inside our tranquil showroom featuring crystal chandeliers, French Louis furniture, and your own private dressing suite.
          </p>
          <p>
            With over 29 years of fashion retail experience and 15 years specializing in bridal styling, Vicky and Samantha offer honest, thoughtful advice with zero pressure.
          </p>
        </div>

        <div class="mt-9 flex items-center gap-4">
          <a
            href="/the-experience"
            class="inline-flex items-center gap-3 border border-stone-700 bg-white px-6 py-3 text-xs tracking-[0.18em] uppercase text-stone-800 hover:bg-stone-800 hover:text-white transition-all duration-300 shadow-xs"
          >
            Our 1-to-1 Experience
            <span class="text-sm">→</span>
          </a>
          <a
            href="/about"
            class="text-xs uppercase tracking-[0.18em] text-stone-600 hover:text-stone-950 underline underline-offset-4 py-2"
          >
            Meet Vicky & Sam
          </a>
        </div>
      </div>

      <!-- Boutique Image -->
      <div class="w-full flex justify-center lg:justify-end">
        <div class="relative overflow-hidden shadow-lg bg-stone-200 w-full max-w-112.5 aspect-square">	
          <img
            src="/images/boutique.webp"
            alt="The Bridal Room Atherstone boutique shop front on Station Street"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center"
          />
        </div>
      </div>

    </div>
  </section>

  <!-- 4. FEATURED DRESSES (Starts at Center Dress on Mobile) -->
  <section class="scroll-mt-24 py-16 sm:py-24 px-6 lg:px-12 bg-sage-100 border-y border-sage-200 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 sm:mb-14">
        <div>
          <p class="text-[11px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">
            Curated Gowns
          </p>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-light uppercase">
            Featured Dresses
          </h2>
        </div>
        <a
          href="/dresses"
          class="mt-3 sm:mt-0 text-xs uppercase tracking-[0.2em] text-stone-700 hover:text-stone-950 underline underline-offset-4"
        >
          View Full Lookbook &rarr;
        </a>
      </div>

      <!-- Dresses Carousel Track -->
      <div
        id="home-dresses-track"
        class="flex md:grid md:grid-cols-3 gap-4 sm:gap-6 lg:gap-10 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pb-4 pt-2 -mx-6 px-8 md:mx-0 md:px-0"
      >
        {featuredDresses.map((dress, index) => (
          <div
            id={`dress-slide-${index}`}
            class="w-[78vw] max-w-71.25 xs:w-[260px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink"
          >
            <DressCard {...dress} />
          </div>
        ))}
      </div>

      <!-- Mobile Indicators for Featured Dresses (Center dot active by default) -->
      <div class="flex md:hidden justify-center items-center gap-2 mt-4" id="home-dresses-dots">
        {featuredDresses.map((_, i) => (
          <button
            class={`h-2 rounded-full transition-all duration-300 ${i === 1 ? 'bg-stone-800 w-4' : 'bg-stone-300 w-2'}`}
            data-index={i}
            aria-label={`View dress slide ${i + 1}`}
          ></button>
        ))}
      </div>

      <div class="mt-10 sm:mt-12 text-center">
        <a
          href="/dresses"
          class="inline-block border border-stone-800 bg-stone-900 text-white px-8 py-3.5 text-xs tracking-[0.2em] uppercase hover:bg-transparent hover:text-stone-900 transition-colors"
        >
          Browse All Collections & Designers
        </a>
      </div>
    </div>
  </section>

  <!-- 5. CONSULTATION TIERS (Starts at Center VIB Suite on Mobile, Unclipped Badge) -->
  <section class="py-20 px-6 lg:px-12 bg-ivory-50 max-w-6xl mx-auto overflow-hidden">
    <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-14">
      <p class="text-[11px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">Private Appointments</p>
      <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-light uppercase">Choose Your Appointment Style</h2>
    </div>

    <!-- Tiers Track with pt-7 so floating badge is never cut off by overflow-x -->
    <div
      id="tiers-carousel-track"
      class="flex md:grid md:grid-cols-3 gap-5 sm:gap-6 lg:gap-8 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pt-7 pb-6 -mx-6 px-8 md:mx-0 md:px-0 items-stretch"
    >
      {consultationTiers.map((tier, index) => (
        <div
          id={`tier-card-${index}`}
          class={`w-[80vw] max-w-77.5 xs:w-[280px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink flex flex-col justify-between p-6 sm:p-8 transition-all relative ${
            tier.isPopular
              ? 'border-2 border-sage-800 bg-sage-50 shadow-md'
              : 'border border-stone-200 bg-white shadow-xs'
          }`}
        >
          {tier.isPopular && (
            <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-20 bg-sage-800 text-white text-[9px] uppercase tracking-[0.2em] px-3.5 py-1 font-medium shadow-sm whitespace-nowrap">
              Most Popular
            </span>
          )}

          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-[10px] tracking-[0.25em] uppercase text-stone-500 block">{tier.name}</span>
              <span class="text-[10px] tracking-wider uppercase text-stone-400 font-light">{tier.duration}</span>
            </div>
            <h3 class="font-serif text-xl sm:text-2xl uppercase text-stone-900 mb-3 font-light leading-snug">
              {tier.title}
            </h3>
            <p class="text-xs text-stone-600 font-light leading-relaxed mb-6">
              {tier.description}
            </p>
          </div>

          <div class="mt-4 pt-4 border-t border-stone-200/70">
            <div class="mb-4">
              <span class="text-base font-medium text-stone-900 block">{tier.price}</span>
              <span class="text-[10px] text-stone-500 font-light">{tier.priceNote}</span>
            </div>
            <a
              href={`/the-experience#book?tier=${encodeURIComponent(tier.bookingParam)}`}
              class={`block w-full text-center py-3 text-[10px] uppercase tracking-[0.2em] transition-colors ${
                tier.isPopular
                  ? 'bg-sage-800 text-white hover:bg-stone-900'
                  : 'border border-stone-800 text-stone-900 hover:bg-stone-900 hover:text-white'
              }`}
            >
              {tier.buttonText}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile Indicator Dots for Consultation Tiers (Center dot active by default) -->
    <div class="flex md:hidden justify-center items-center gap-2 mt-2" id="tiers-carousel-dots">
      {consultationTiers.map((_, i) => (
        <button
          class={`h-2 rounded-full transition-all duration-300 ${i === 1 ? 'bg-sage-800 w-4' : 'bg-stone-300 w-2'}`}
          data-index={i}
          aria-label={`Go to tier slide ${i + 1}`}
        ></button>
      ))}
    </div>
  </section>

  <!-- 6. BOOK APPOINTMENT CTA BANNER -->
  <section class="relative bg-sage-200 py-16 sm:py-20 px-6 overflow-hidden">
    <img
      src="/images/leaf.svg"
      alt=""
      aria-hidden="true"
      class="absolute left-2 sm:left-6 lg:left-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-35 pointer-events-none select-none"
    />
    <img
      src="/images/leaf.svg"
      alt=""
      aria-hidden="true"
      class="absolute right-2 sm:right-6 lg:right-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-35 pointer-events-none select-none -scale-x-100"
    />

    <div class="relative z-10 max-w-xl mx-auto text-center">
      <p class="text-[10px] sm:text-[11px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">
        Ready to Find Yours?
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-stone-900 font-light mb-3">
        Book Your Private Suite
      </h2>
      <p class="font-serif italic text-base sm:text-lg text-stone-600 mb-8">
        Wednesday late evenings available up to 9:00pm.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/the-experience#book"
          class="inline-flex items-center gap-3 border border-stone-800 bg-stone-900 text-white px-8 py-3.5 text-xs tracking-[0.2em] uppercase hover:bg-transparent hover:text-stone-900 transition-all duration-300 w-full sm:w-auto justify-center"
        >
          Book Online
          <span class="text-sm">→</span>
        </a>
        <a
          href={PHONE_HREF}
          class="inline-flex items-center gap-2 border border-stone-700 bg-transparent px-6 py-3.5 text-xs tracking-[0.2em] uppercase text-stone-900 hover:bg-stone-800 hover:text-white transition-all duration-300 w-full sm:w-auto justify-center"
        >
          Call {PHONE_NUMBER}
        </a>
      </div>
    </div>
  </section>

  <!-- 7. HOMEPAGE CONTEXTUAL FAQS -->
  <section class="py-16 sm:py-24 px-6 max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <p class="text-[10px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">Helpful Information</p>
      <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 font-light uppercase">Frequently Asked Questions</h2>
    </div>
    <FAQAccordion faqs={homepageFaqs} />
  </section>
</BaseLayout>

<script>
  // Pure Horizontal Centering (No vertical window jump)
  function centerTrackChild(track: HTMLElement | null, childIndex: number) {
    if (!track || window.innerWidth >= 1024) return;
    const child = track.children[childIndex] as HTMLElement;
    if (!child) return;

    const trackWidth = track.clientWidth;
    const childWidth = child.offsetWidth;
    const childLeft = child.offsetLeft;
    track.scrollLeft = childLeft - (trackWidth - childWidth) / 2;
  }

  // 1. Featured Dresses Mobile Carousel
  const dressesTrack = document.getElementById('home-dresses-track');
  const dressesDots = document.querySelectorAll('#home-dresses-dots button');

  if (dressesTrack && dressesDots.length > 0) {
    const initDressCenter = () => centerTrackChild(dressesTrack, 1);
    requestAnimationFrame(initDressCenter);
    window.addEventListener('load', initDressCenter);

    dressesTrack.addEventListener('scroll', () => {
      const scrollLeft = dressesTrack.scrollLeft;
      const cardWidth = dressesTrack.firstElementChild?.clientWidth || 1;
      const activeIdx = Math.min(
        dressesDots.length - 1,
        Math.max(0, Math.round(scrollLeft / cardWidth))
      );

      dressesDots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.classList.add('bg-stone-800', 'w-4');
          dot.classList.remove('bg-stone-300', 'w-2');
        } else {
          dot.classList.remove('bg-stone-800', 'w-4');
          dot.classList.add('bg-stone-300', 'w-2');
        }
      });
    }, { passive: true });

    dressesDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-index') || 0);
        centerTrackChild(dressesTrack, idx);
      });
    });
  }

  // 2. Consultation Tiers Mobile Carousel (Center on VIB Suite)
  const tiersTrack = document.getElementById('tiers-carousel-track');
  const tiersDots = document.querySelectorAll('#tiers-carousel-dots button');

  if (tiersTrack && tiersDots.length > 0) {
    const initTierCenter = () => centerTrackChild(tiersTrack, 1);
    requestAnimationFrame(initTierCenter);
    window.addEventListener('load', initTierCenter);

    tiersTrack.addEventListener('scroll', () => {
      const scrollLeft = tiersTrack.scrollLeft;
      const cardWidth = tiersTrack.firstElementChild?.clientWidth || 1;
      const activeIdx = Math.min(
        tiersDots.length - 1,
        Math.max(0, Math.round(scrollLeft / cardWidth))
      );

      tiersDots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.classList.add('bg-sage-800', 'w-4');
          dot.classList.remove('bg-stone-300', 'w-2');
        } else {
          dot.classList.remove('bg-sage-800', 'w-4');
          dot.classList.add('bg-stone-300', 'w-2');
        }
      });
    }, { passive: true });

    tiersDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-index') || 0);
        centerTrackChild(tiersTrack, idx);
      });
    });
  }
</script>