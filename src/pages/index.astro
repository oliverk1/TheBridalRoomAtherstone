---
// src/pages/index.astro
import '../styles/global.css';

const PHONE_NUMBER = "01827 946 098";
const PHONE_HREF = "tel:01827946098";

// All 6 individual selling points (shown 1-at-a-time on mobile)
const singleSellingPoints = [
  "100% Private 1-to-1 Suites",
  "Curated Made to Order Gowns £1,200 – £2,500",
  "Designer Ex-Sample Rail from £250 – £900",
  "Discontinued Designer Styles with 20% Off RRP",
  "Personal & Unhurried Appointments",
  "Intimate Warwickshire Boutique Setting"
];

// Desktop 2-group set (shown 3-at-a-time on desktop)
const tickerGroups = [
  [
    singleSellingPoints[0],
    singleSellingPoints[1],
    singleSellingPoints[2]
  ],
  [
    singleSellingPoints[3],
    singleSellingPoints[4],
    singleSellingPoints[5]
  ]
];
---

<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>The Bridal Room | Luxury Bridal Boutique Atherstone, Warwickshire</title>
    <meta
      name="description"
      content="The Bridal Room Atherstone is an intimate Warwickshire bridal boutique offering exclusive private bridal appointments. Curated Made to Order and Designer Sample gowns."
    />
    <meta name="keywords" content="bridal shop Atherstone, wedding dresses Warwickshire, private bridal appointments, bridal boutique Atherstone, designer wedding gowns, sample sale dresses" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="The Bridal Room Atherstone | Private Bridal Appointments" />
    <meta property="og:description" content="Discover your dream wedding dress in an intimate, private Warwickshire boutique. Thoughtfully styled around you." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Local Business Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BridalStore",
      "name": "The Bridal Room Atherstone",
      "description": "Intimate luxury bridal boutique in Warwickshire offering private appointments, made-to-order designer gowns, and sample wedding dresses.",
      "telephone": PHONE_NUMBER,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "65 Station Street",
        "addressLocality": "Atherstone",
        "addressRegion": "Warwickshire",
        "postalCode": "CV9 1DB",
        "addressCountry": "GB"
      },
      "priceRange": "££"
    })} />

    <style>
      .scrollbar-none::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-none {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="bg-ivory-50 text-stone-800 font-sans antialiased selection:bg-sage-200">

    <!-- STICKY HEADER -->
    <header class="sticky top-0 z-50 bg-sage-100/95 backdrop-blur-md border-b border-sage-200 transition-all duration-300">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-12 py-3 lg:py-4 relative z-10">
        
        <!-- Brand Title & Subtitle -->
        <div class="text-center mb-2.5 lg:mb-3.5">
          <a href="#" class="inline-block group">
            <h1 class="font-serif text-xl sm:text-2xl md:text-3xl tracking-[0.25em] text-stone-800 uppercase font-light group-hover:text-stone-950 transition-colors">
              The Bridal Room
            </h1>
            <div class="flex items-center justify-center gap-3 mt-1 text-[9px] sm:text-[10px] tracking-[0.35em] text-stone-600 uppercase font-light">
              <span class="w-6 sm:w-8 h-px bg-stone-400"></span>
              Atherstone
              <span class="w-6 sm:w-8 h-px bg-stone-400"></span>
            </div>
          </a>
        </div>

        <!-- Desktop Navigation Bar -->
        <nav class="hidden lg:flex items-center justify-center gap-8 text-xs tracking-[0.18em] uppercase text-stone-700">
          <a href="#" class="hover:text-stone-950 transition-colors">Home</a>
          <a href="#collection" class="hover:text-stone-950 transition-colors">Dresses</a>
          <a href="#experience" class="hover:text-stone-950 transition-colors">The Experience</a>
          <a href="#experience" class="hover:text-stone-950 transition-colors">About</a>
          <a href="#contact" class="hover:text-stone-950 transition-colors">Contact</a>
          <a
            href="#book"
            class="border border-stone-600 px-5 py-2 hover:bg-stone-800 hover:text-white transition-all duration-300 ml-2"
          >
            Book an Appointment
          </a>
        </nav>

        <!-- Mobile Top Bar -->
        <div class="flex lg:hidden items-center justify-between pt-1">
          <a
            href="#book"
            class="text-[10px] uppercase tracking-[0.2em] border border-stone-700 px-3.5 py-1.5 bg-transparent text-stone-800 hover:bg-stone-800 hover:text-white transition-colors"
          >
            Book an Appointment
          </a>
          <button
            id="mobile-menu-toggle"
            aria-label="Toggle navigation menu"
            class="p-2 text-stone-800 focus:outline-none"
          >
            <svg id="menu-icon-bars" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Mobile Collapsible Menu -->
        <div
          id="mobile-menu"
          class="hidden lg:hidden flex flex-col gap-4 pt-5 pb-3 text-center text-xs tracking-[0.2em] uppercase border-t border-sage-200 mt-3"
        >
          <a href="#" class="py-2 hover:text-stone-500 mobile-nav-link">Home</a>
          <a href="#collection" class="py-2 hover:text-stone-500 mobile-nav-link">Dresses</a>
          <a href="#experience" class="py-2 hover:text-stone-500 mobile-nav-link">The Experience</a>
          <a href="#experience" class="py-2 hover:text-stone-500 mobile-nav-link">About</a>
          <a href="#contact" class="py-2 hover:text-stone-500 mobile-nav-link">Contact</a>
          <a href={PHONE_HREF} class="py-2 text-stone-900 font-medium mobile-nav-link">Call: {PHONE_NUMBER}</a>
        </div>
      </div>
    </header>

    <!-- HERO SECTION (Mobile focuses on the final third / right-side bride: object-[85%_top]) -->
    <section class="relative h-[calc(100svh-140px)] lg:h-[calc(100vh-160px)] min-h-[500px] max-h-[720px] flex items-center overflow-hidden">
      <img
        src="/images/hero.webp"
        alt="The Bridal Room Atherstone boutique showroom wedding gown collection"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="absolute inset-0 w-full h-full object-cover object-[85%_top] sm:object-top"
      />
      <div class="absolute inset-0 bg-linear-to-r from-stone-900/75 via-stone-900/40 to-transparent"></div>

      <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-12 w-full py-8 text-white">
        <div class="max-w-xl">
          <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-light tracking-wide uppercase leading-tight mb-3">
            Find The Dress
          </h2>
          <p class="font-serif italic text-base sm:text-xl text-stone-200 font-light mb-8">
            A considered bridal experience, beautifully personal.
          </p>
          <a
            href="#collection"
            class="inline-flex items-center gap-3 border border-white/80 bg-black/30 backdrop-blur-sm px-6 py-3 text-xs tracking-[0.2em] uppercase hover:bg-white hover:text-stone-900 transition-all duration-300"
          >
            Explore the Collection
            <span class="text-sm">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- TICKER CAROUSEL (Mobile shows 1-at-a-time, Desktop shows 3-at-a-time) -->
    <div
      id="carousel-wrapper"
      class="bg-sage-100 border-b border-sage-200 py-5 sm:py-6 px-4 relative overflow-hidden select-none cursor-grab active:cursor-grabbing touch-pan-y"
    >
      <div class="max-w-6xl mx-auto overflow-hidden">
        
        <!-- DESKTOP TRACK (3 items per view) -->
        <div id="desktop-carousel-track" class="hidden lg:flex w-full will-change-transform">
          <!-- Clone of Group 2 (Index 0) -->
          <div class="w-full shrink-0 flex items-center justify-between gap-8 px-6" aria-hidden="true">
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[1][0]}</span></div>
            <div class="w-px h-4 bg-stone-300"></div>
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[1][1]}</span></div>
            <div class="w-px h-4 bg-stone-300"></div>
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[1][2]}</span></div>
          </div>

          <!-- Group 1 (Index 1) -->
          <div class="w-full shrink-0 flex items-center justify-between gap-8 px-6">
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[0][0]}</span></div>
            <div class="w-px h-4 bg-stone-300"></div>
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[0][1]}</span></div>
            <div class="w-px h-4 bg-stone-300"></div>
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[0][2]}</span></div>
          </div>

          <!-- Group 2 (Index 2) -->
          <div class="w-full shrink-0 flex items-center justify-between gap-8 px-6">
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[1][0]}</span></div>
            <div class="w-px h-4 bg-stone-300"></div>
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[1][1]}</span></div>
            <div class="w-px h-4 bg-stone-300"></div>
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[1][2]}</span></div>
          </div>

          <!-- Clone of Group 1 (Index 3) -->
          <div class="w-full shrink-0 flex items-center justify-between gap-8 px-6" aria-hidden="true">
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[0][0]}</span></div>
            <div class="w-px h-4 bg-stone-300"></div>
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[0][1]}</span></div>
            <div class="w-px h-4 bg-stone-300"></div>
            <div class="flex-1 text-center"><span class="text-xs tracking-[0.22em] uppercase text-stone-700 font-light block">{tickerGroups[0][2]}</span></div>
          </div>
        </div>

        <!-- MOBILE TRACK (1 item per view) -->
        <div id="mobile-carousel-track" class="flex lg:hidden w-full will-change-transform">
          <div class="w-full shrink-0 text-center px-4" aria-hidden="true">
            <span class="text-[11px] sm:text-xs tracking-[0.2em] uppercase text-stone-700 font-light block">
              {singleSellingPoints[5]}
            </span>
          </div>

          {singleSellingPoints.map((point) => (
            <div class="w-full shrink-0 text-center px-4">
              <span class="text-[11px] sm:text-xs tracking-[0.2em] uppercase text-stone-700 font-light block">
                {point}
              </span>
            </div>
          ))}

          <div class="w-full shrink-0 text-center px-4" aria-hidden="true">
            <span class="text-[11px] sm:text-xs tracking-[0.2em] uppercase text-stone-700 font-light block">
              {singleSellingPoints[0]}
            </span>
          </div>
        </div>

      </div>

      <!-- DESKTOP DOTS -->
      <div class="hidden lg:flex justify-center items-center gap-2.5 mt-3.5" id="desktop-carousel-dots">
        <button class="w-2.5 h-2.5 rounded-full bg-stone-800 transition-all duration-300 hover:scale-125" aria-label="Slide 1"></button>
        <button class="w-2.5 h-2.5 rounded-full bg-stone-300 transition-all duration-300 hover:scale-125" aria-label="Slide 2"></button>
      </div>

      <!-- MOBILE DOTS -->
      <div class="flex lg:hidden justify-center items-center gap-2 mt-3.5" id="mobile-carousel-dots">
        {singleSellingPoints.map((_, i) => (
          <button class={`w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-stone-800' : 'bg-stone-300'}`} aria-label={`Slide ${i + 1}`}></button>
        ))}
      </div>
    </div>

    <!-- BOUTIQUE EXPERIENCE SECTION -->
    <section id="experience" class="scroll-mt-24 lg:scroll-mt-28 py-20 sm:py-28 lg:py-32 px-6 lg:px-12 bg-ivory-50">
      <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        
        <!-- Text Column -->
        <div class="max-w-lg">
          <div class="flex items-center gap-3 text-[11px] tracking-[0.28em] text-stone-600 uppercase font-light mb-5">
            <span>The Bridal Room</span>
            <span class="w-12 h-px bg-stone-400"></span>
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light text-stone-900 leading-tight mb-7">
            A boutique experience,<br />
            <span class="italic font-light">just for you.</span>
          </h2>

          <div class="space-y-5 text-sm sm:text-[15px] leading-relaxed text-stone-600 font-light">
            <p>
              At The Bridal Room, Atherstone, we believe finding your dress should be as special as the day itself. Our beautiful, private appointments offer a calm and relaxed environment where you can explore our carefully curated collection, away from the crowds.
            </p>
            <p>
              We take the time to understand your style, your vision and what makes you feel extraordinary, ensuring every moment is personal, unhurried and truly memorable.
            </p>
          </div>

          <div class="mt-9">
            <a
              href="#book"
              class="inline-flex items-center gap-3 border border-stone-700 bg-white px-6 py-3 text-xs tracking-[0.18em] uppercase text-stone-800 hover:bg-stone-800 hover:text-white transition-all duration-300 shadow-xs"
            >
              Discover Our Experience
              <span class="text-sm">→</span>
            </a>
          </div>
        </div>

        <!-- Image Column -->
        <div class="w-full flex justify-center lg:justify-end">
          <div class="relative overflow-hidden shadow-lg bg-stone-200 w-full max-w-sm sm:max-w-md aspect-square lg:aspect-[4/5] lg:max-h-[500px]">
            <img
              src="/images/boutique.webp"
              alt="The Bridal Room Atherstone boutique shop front on Station Street"
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center"
            />
          </div>
        </div>

      </div>
    </section>

    <!-- FEATURED DRESSES SECTION -->
    <section id="collection" class="scroll-mt-24 lg:scroll-mt-28 py-16 sm:py-24 px-6 lg:px-12 bg-sage-100">
      <div class="max-w-6xl mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-10 sm:mb-14">
          <p class="text-[11px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">
            Our Collection
          </p>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-light">
            Featured Dresses
          </h2>
        </div>

        <!-- Dresses Container: Grid on Desktop (md:), Horizontal Scroll on Mobile -->
        <div
          id="dresses-track"
          class="flex md:grid md:grid-cols-3 gap-4 sm:gap-6 lg:gap-10 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pb-4 -mx-6 px-6 md:mx-0 md:px-0"
        >
          
          <!-- Card 1 -->
          <a
            href="#book"
            class="w-[70vw] max-w-[270px] xs:w-[250px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-ivory-50 border border-stone-200/70 p-4 sm:p-5 flex flex-col group shadow-xs hover:border-stone-400 hover:shadow-md transition-all duration-300 cursor-pointer block text-center"
          >
            <div class="aspect-4/5 overflow-hidden bg-stone-200 mb-5 sm:mb-6">
              <img
                src="/images/dress-1.webp"
                alt="Romantic lace low-back wedding dress with train"
                width="700"
                height="875"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
            </div>
            <div class="mt-auto pb-1 sm:pb-2">
              <h3 class="text-xs tracking-[0.25em] uppercase text-stone-800 font-medium mb-1.5 sm:mb-2 group-hover:text-stone-950">
                Romantic Lace
              </h3>
              <span class="inline-flex items-center gap-1.5 text-xs text-stone-500 group-hover:text-stone-900 tracking-wider transition-colors">
                View Dress <span class="text-sm transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </div>
          </a>

          <!-- Card 2 -->
          <a
            href="#book"
            class="w-[70vw] max-w-[270px] xs:w-[250px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-ivory-50 border border-stone-200/70 p-4 sm:p-5 flex flex-col group shadow-xs hover:border-stone-400 hover:shadow-md transition-all duration-300 cursor-pointer block text-center"
          >
            <div class="aspect-4/5 overflow-hidden bg-stone-200 mb-5 sm:mb-6">
              <img
                src="/images/dress-2.webp"
                alt="Modern classics clean minimalist wedding dress"
                width="700"
                height="875"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
            </div>
            <div class="mt-auto pb-1 sm:pb-2">
              <h3 class="text-xs tracking-[0.25em] uppercase text-stone-800 font-medium mb-1.5 sm:mb-2 group-hover:text-stone-950">
                Modern Classics
              </h3>
              <span class="inline-flex items-center gap-1.5 text-xs text-stone-500 group-hover:text-stone-900 tracking-wider transition-colors">
                View Dress <span class="text-sm transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </div>
          </a>

          <!-- Card 3 -->
          <a
            href="#book"
            class="w-[70vw] max-w-[270px] xs:w-[250px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-ivory-50 border border-stone-200/70 p-4 sm:p-5 flex flex-col group shadow-xs hover:border-stone-400 hover:shadow-md transition-all duration-300 cursor-pointer block text-center"
          >
            <div class="aspect-4/5 overflow-hidden bg-stone-200 mb-5 sm:mb-6">
              <img
                src="/images/dress-3.webp"
                alt="Timeless floral applique bridal gown Justin Alexander collection"
                width="700"
                height="875"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
            </div>
            <div class="mt-auto pb-1 sm:pb-2">
              <h3 class="text-xs tracking-[0.25em] uppercase text-stone-800 font-medium mb-1.5 sm:mb-2 group-hover:text-stone-950">
                Timeless Beauty
              </h3>
              <span class="inline-flex items-center gap-1.5 text-xs text-stone-500 group-hover:text-stone-900 tracking-wider transition-colors">
                View Dress <span class="text-sm transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </div>
          </a>

        </div>

        <!-- Mobile Indicator Dots for Dresses -->
        <div class="flex md:hidden justify-center items-center gap-2 mt-4" id="dresses-dots">
          <span class="w-2 h-2 rounded-full bg-stone-800 transition-all duration-300"></span>
          <span class="w-2 h-2 rounded-full bg-stone-300 transition-all duration-300"></span>
          <span class="w-2 h-2 rounded-full bg-stone-300 transition-all duration-300"></span>
        </div>

      </div>
    </section>

    <!-- BOOK APPOINTMENT CTA BANNER -->
    <section id="book" class="scroll-mt-24 lg:scroll-mt-28 relative bg-sage-200 py-16 sm:py-20 px-6 overflow-hidden">
      <!-- Left Leaf Image -->
      <img
        src="/images/leaf.svg"
        alt=""
        aria-hidden="true"
        class="absolute left-2 sm:left-6 lg:left-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-35 pointer-events-none select-none"
      />

      <!-- Right Leaf Image -->
      <img
        src="/images/leaf.svg"
        alt=""
        aria-hidden="true"
        class="absolute right-2 sm:right-6 lg:right-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-35 pointer-events-none select-none -scale-x-100"
      />

      <div class="relative z-10 max-w-xl mx-auto text-center">
        <p class="text-[10px] sm:text-[11px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">
          Ready to Find Yours?
        </p>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-stone-900 font-light mb-2 sm:mb-3">
          Book Your Appointment
        </h2>
        <p class="font-serif italic text-base sm:text-lg text-stone-600 mb-6 sm:mb-8">
          Let's find the dress, together.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#"
            class="inline-flex items-center gap-3 border border-stone-800 bg-stone-900 text-white px-8 py-3.5 text-xs tracking-[0.2em] uppercase hover:bg-transparent hover:text-stone-900 transition-all duration-300 w-full sm:w-auto justify-center"
          >
            Book Online
            <span class="text-sm">→</span>
          </a>
          <a
            href={PHONE_HREF}
            class="inline-flex items-center gap-2 border border-stone-700 bg-transparent px-6 py-3.5 text-xs tracking-[0.2em] uppercase text-stone-900 hover:bg-stone-800 hover:text-white transition-all duration-300 w-full sm:w-auto justify-center"
          >
            Call {PHONE_NUMBER}
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer id="contact" class="scroll-mt-24 lg:scroll-mt-28 bg-ivory-50 border-t border-stone-200 pt-16 pb-12 px-6 lg:px-12">
      <div class="max-w-6xl mx-auto">
        
        <!-- Centered Brand Block -->
        <div class="text-center mb-14">
          <h4 class="font-serif text-2xl sm:text-3xl tracking-[0.25em] text-stone-900 uppercase font-light">
            The Bridal Room
          </h4>
          <div class="flex items-center justify-center gap-3 mt-1.5 text-[10px] tracking-[0.35em] text-stone-600 uppercase font-light">
