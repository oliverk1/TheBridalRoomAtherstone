---
// src/pages/contact.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';

// Pull decoupled data from Decap CMS JSON settings
import faqsData from '../content/settings/faqs.json';
import scheduleConfig from '../content/settings/schedule.json';

const contactFaqs = faqsData.contactFaqs;

const PHONE_NUMBER = "01827 946 098";
const PHONE_HREF = "tel:01827946098";
const EMAIL_ADDRESS = "thebridalroomatherstone@gmail.com";
const MAPS_LINK = "https://maps.google.com/?cid=12382957442756199143&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNlEAMYASAF&hl=en&gl=GB";

// Extract dynamic hours directly from schedule.json
const hours = scheduleConfig.weeklyHours as any;

// Format day labels
function formatHours(dayCfg: any) {
  if (!dayCfg || !dayCfg.isOpen) return "Closed (Special Request)";
  return `${dayCfg.open} – ${dayCfg.close}`;
}

const monTueHours = formatHours(hours.monday);
const wedHours = formatHours(hours.wednesday);
const thuSatHours = formatHours(hours.saturday);
const sunHours = formatHours(hours.sunday);
---

<BaseLayout
  title="Contact & Visit The Boutique | The Bridal Room Atherstone"
  description="Visit The Bridal Room at 65 Station Street, Atherstone CV9 1DB. 1-minute walk from Cattle Market Car Park. Wed late nights to 9pm. Regional travel guide from Tamworth, Coventry & Birmingham."
  faqs={contactFaqs}
>
  <!-- 1. EDITORIAL HEADER -->
  <section class="bg-sage-100 border-b border-sage-200 py-16 sm:py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="flex items-center justify-center gap-3 text-[10px] tracking-[0.35em] text-stone-600 uppercase font-light mb-3">
        <span class="w-8 h-px bg-stone-400"></span>
        Warwickshire Bridal Haven
        <span class="w-8 h-px bg-stone-400"></span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl uppercase font-light text-stone-900 tracking-wide mb-4">
        Contact &amp; Visit Us
      </h1>
      <p class="font-serif italic text-base sm:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed">
        Located on historic Station Street in Atherstone. Free local parking, direct rail links, and Wednesday late-night fittings.
      </p>
    </div>
  </section>

  <!-- 2. MAIN VISIT & ENQUIRY SECTION (Editorial 2-Column) -->
  <section class="py-20 sm:py-28 px-6 lg:px-12 bg-ivory-50">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Location, Dynamic Hours & Travel (lg:col-span-6) -->
      <div class="lg:col-span-6 space-y-10">
        <div>
          <span class="text-[10px] tracking-[0.3em] uppercase text-stone-500 block mb-2 font-medium">
            Location &amp; Appointments
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-light uppercase leading-tight mb-4">
            The Flagship Showroom
          </h2>
          <p class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed">
            Our boutique is set inside a historic Atherstone townhouse on Station Street. To ensure every bride enjoys complete privacy, appointments are required for all showroom visits.
          </p>
        </div>

        <!-- Address & Contact Info with Dedicated SVGs -->
        <div class="space-y-5 pt-2 border-t border-stone-200/80">
          
          <!-- Address Row with Location Pin SVG -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-sage-100 flex items-center justify-center text-sage-900 shrink-0 shadow-2xs">
              <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s-7-6.5-7-11a7 7 0 1 1 14 0c0 4.5-7 11-7 11z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
            </div>
            <div>
              <strong class="text-xs uppercase tracking-wider text-stone-900 block font-medium">Boutique Address</strong>
              <address class="not-italic text-xs text-stone-600 font-light leading-relaxed mt-0.5">
                The Bridal Room<br />
                65 Station Street, Atherstone, Warwickshire CV9 1DB
              </address>
              <a
                href={MAPS_LINK}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block text-[10px] uppercase tracking-wider text-sage-900 font-medium underline underline-offset-4 hover:text-stone-900 mt-1.5 transition-colors"
              >
                Open in Google Maps &rarr;
              </a>
            </div>
          </div>

          <!-- Phone Row with Phone Receiver SVG -->
          <div class="flex items-start gap-4 pt-1">
            <div class="w-10 h-10 rounded-full bg-sage-100 flex items-center justify-center text-sage-900 shrink-0 shadow-2xs">
              <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <div>
              <strong class="text-xs uppercase tracking-wider text-stone-900 block font-medium">Direct Telephone &amp; Email</strong>
              <p class="text-xs text-stone-600 font-light leading-relaxed mt-0.5">
                Tel: <a href={PHONE_HREF} class="text-stone-900 underline underline-offset-2 font-normal hover:text-sage-900">{PHONE_NUMBER}</a>
              </p>
              <p class="text-xs text-stone-600 font-light leading-relaxed">
                Email: <a href={`mailto:${EMAIL_ADDRESS}`} class="hover:underline">{EMAIL_ADDRESS}</a>
              </p>
            </div>
          </div>

        </div>

        <!-- Dynamic Opening Hours Table (Pulled from schedule.json) -->
        <div class="pt-2 border-t border-stone-200/80">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-serif text-xl uppercase text-stone-900 font-light">Fitting Hours</h3>
            <span class="text-[10px] text-stone-400 uppercase tracking-widest font-light">By Appointment</span>
          </div>
          <ul class="space-y-2 text-xs text-stone-600 font-light divide-y divide-stone-200/60">
            <li class="flex justify-between pt-2">
              <span>Monday &amp; Tuesday:</span>
              <span class="text-stone-900 font-medium">{monTueHours}</span>
            </li>
            <li class="flex justify-between pt-2 text-sage-900 font-medium">
              <span>Wednesday (Late Night):</span>
              <span>{wedHours} ★</span>
            </li>
            <li class="flex justify-between pt-2">
              <span>Thursday – Saturday:</span>
              <span class="text-stone-900 font-medium">{thuSatHours}</span>
            </li>
            <li class="flex justify-between pt-2 text-stone-400">
              <span>Sunday:</span>
              <span>{sunHours}</span>
            </li>
          </ul>
        </div>

        <!-- Parking & Travel Feature -->
        <div class="p-6 bg-sage-50/70 border-l-2 border-sage-800 rounded-2xs space-y-2">
          <strong class="text-xs uppercase tracking-wider text-sage-900 block font-medium">
            Free 2-Hour Parking (1-Minute Walk)
          </strong>
          <p class="text-xs text-stone-600 font-light leading-relaxed">
            <strong>Cattle Market Car Park</strong> is located just 80 metres from our boutique.
          </p>
          <ul class="text-[11px] text-stone-600 space-y-1 font-light">
            <li>&bull; <strong>Sat Nav Postcode:</strong> <span class="font-mono text-stone-900 font-medium">CV9 1DD</span></li>
            <li>&bull; <strong>Free Parking:</strong> First 2 hours free of charge (ticket or app registration required)</li>
            <li>&bull; <strong>Location Code:</strong> <span class="font-mono text-stone-900 font-medium">3611082</span> (RingGo)</li>
            <li>&bull; <strong>By Train:</strong> Atherstone Station is a 2-minute level walk down Station Street</li>
          </ul>
        </div>

        <!-- Regional Driving Times Strip -->
        <div class="pt-2 border-t border-stone-200/80">
          <p class="text-[10px] uppercase tracking-widest text-stone-500 mb-2 font-medium">Regional Travel Times</p>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs text-stone-600 font-light">
            <span>Tamworth: <strong class="font-medium text-stone-900">12m</strong></span>
            <span>Nuneaton: <strong class="font-medium text-stone-900">15m</strong></span>
            <span>Hinckley: <strong class="font-medium text-stone-900">18m</strong></span>
            <span>Sutton Coldfield: <strong class="font-medium text-stone-900">25m</strong></span>
            <span>Coventry: <strong class="font-medium text-stone-900">30m</strong></span>
            <span>Birmingham: <strong class="font-medium text-stone-900">35m</strong></span>
          </div>
        </div>
      </div>

      <!-- Right Column: Validated Enquiry Form (lg:col-span-6) -->
      <div class="lg:col-span-6 border-t lg:border-t-0 lg:border-l border-stone-200/90 pt-10 lg:pt-0 lg:pl-12">
        <div class="mb-6">
          <span class="text-[10px] tracking-[0.3em] uppercase text-stone-500 block mb-1 font-medium">
            Have a Question?
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-light uppercase leading-tight mb-2">
            Send an Enquiry
          </h2>
          <p class="text-xs text-stone-500 font-light leading-relaxed">
            Need advice on order timelines, seamstress fittings, or gown availability? Send us a note below and Vicky or Samantha will get back to you directly.
          </p>
        </div>

        <!-- Validated Form -->
        <form id="contact-enquiry-form" class="space-y-4" novalidate>
          <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY || "YOUR_ACCESS_KEY_HERE"} />
          <input type="hidden" name="subject" value="New Customer Enquiry — The Bridal Room Atherstone" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Full Name -->
          <div>
            <label class="block text-[10px] uppercase tracking-wider text-stone-700 mb-1">Your Full Name *</label>
            <input
              type="text"
              name="name"
              id="contact-name"
              required
              class="w-full border border-stone-300 p-3 text-xs bg-white rounded-xs focus:border-stone-900 focus:outline-none transition-colors"
            />
            <span id="err-name" class="contact-error hidden text-[10px] text-red-700 mt-1 block">Please enter your full name (minimum 2 letters)</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Email Address (Configured cleanly to prevent browser icon overlap) -->
            <div>
              <label class="block text-[10px] uppercase tracking-wider text-stone-700 mb-1">Email Address *</label>
              <input
                type="email"
                name="email"
                id="contact-email"
                required
                autocomplete="email"
                placeholder="bride@example.co.uk"
                class="w-full border border-stone-300 p-3 text-xs bg-white rounded-xs focus:border-stone-900 focus:outline-none transition-colors"
              />
              <span id="err-email" class="contact-error hidden text-[10px] text-red-700 mt-1 block">Please enter a valid email address</span>
            </div>

            <!-- Phone Number -->
            <div>
              <label class="block text-[10px] uppercase tracking-wider text-stone-700 mb-1">Telephone Number</label>
              <input
                type="tel"
                name="phone"
                id="contact-phone"
                autocomplete="tel"
                placeholder="07123 456789"
                class="w-full border border-stone-300 p-3 text-xs bg-white rounded-xs focus:border-stone-900 focus:outline-none transition-colors"
              />
              <span id="err-phone" class="contact-error hidden text-[10px] text-red-700 mt-1 block">Please enter a valid UK phone number</span>
            </div>
          </div>

          <!-- Nature of Enquiry Dropdown -->
          <div>
            <label class="block text-[10px] uppercase tracking-wider text-stone-700 mb-1">Nature of Enquiry *</label>
            <select
              name="enquiryType"
              id="contact-type"
              class="w-full border border-stone-300 p-3 text-xs bg-white rounded-xs focus:border-stone-900 focus:outline-none"
            >
              <option value="General Question">General Question</option>
              <option value="Dress Lead Times & Ordering">Dress Lead Times &amp; Ordering</option>
              <option value="Sample Sale Rail Gowns">Sample Sale Rail Gowns</option>
              <option value="Veil & Accessory Styling">Veil &amp; Accessory Styling</option>
              <option value="Alterations & Seamstress">Alterations &amp; Seamstress Service</option>
            </select>
          </div>

          <!-- Message -->
          <div>
            <label class="block text-[10px] uppercase tracking-wider text-stone-700 mb-1">How Can We Help? *</label>
            <textarea
              name="message"
              id="contact-message"
              rows="4"
              required
              placeholder="Tell us about your wedding date, gown vision, or any specific questions..."
              class="w-full border border-stone-300 p-3 text-xs bg-white rounded-xs focus:border-stone-900 focus:outline-none transition-colors"
            ></textarea>
            <span id="err-message" class="contact-error hidden text-[10px] text-red-700 mt-1 block">Please write your message (minimum 10 characters)</span>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="contact-submit-btn"
              class="w-full bg-stone-900 text-white text-xs uppercase tracking-[0.2em] py-4 hover:bg-sage-900 transition-colors cursor-pointer font-medium shadow-xs"
            >
              Send Enquiry &rarr;
            </button>
          </div>
        </form>

        <!-- Success Screen -->
        <div id="contact-success-box" class="hidden text-center py-10 bg-sage-50 border border-sage-200 rounded-xs mt-4">
          <div class="w-10 h-10 bg-sage-200 text-sage-900 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 stroke-current fill-none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          </div>
          <h4 class="font-serif text-2xl uppercase text-stone-900 font-light mb-1">Enquiry Received</h4>
          <p class="text-xs text-stone-600 font-light max-w-sm mx-auto leading-relaxed">
            Thank you. Vicky or Samantha will reply to your email shortly.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. BUILT-IN GOOGLE MAP EMBED (Exact Place Location with CID) -->
  <section class="bg-ivory-100/70 border-y border-stone-200 py-16 sm:py-20 px-6 lg:px-12">
    <div class="max-w-6xl mx-auto">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <span class="text-[10px] tracking-[0.3em] uppercase text-stone-500 block mb-1 font-medium">Boutique Map</span>
          <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 font-light uppercase">
            65 Station Street, Atherstone
          </h2>
        </div>
        
        <!-- Exact Google Maps Destination Button -->
        <a
          href={MAPS_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 border border-stone-800 bg-white px-5 py-2.5 text-xs tracking-[0.18em] uppercase text-stone-900 hover:bg-stone-900 hover:text-white transition-all shadow-xs"
        >
          <span>Open in Google Maps / Directions</span>
          <span class="text-sm">↗</span>
        </a>
      </div>

      <!-- Embedded Map using Company CID -->
      <div class="relative w-full h-[380px] sm:h-[450px] border border-stone-300/90 shadow-md bg-stone-200 overflow-hidden rounded-xs">
        <iframe
          title="The Bridal Room Atherstone Location Map"
          width="100%"
          height="100%"
          style="border:0;"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src="https://maps.google.com/maps?cid=12382957442756199143&output=embed"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- 4. APPOINTMENT CTA BANNER (With Leaf SVGs) -->
  <section class="relative bg-sage-200 py-20 sm:py-24 px-6 border-b border-sage-300 overflow-hidden text-center">
    <img
      src="/images/leaf.svg"
      alt=""
      aria-hidden="true"
      class="absolute left-2 sm:left-6 lg:left-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-35 pointer-events-none select-none"
    />
    <img
      src="/images/leaf.svg"
      alt=""
      aria-hidden="true"
      class="absolute right-2 sm:right-6 lg:right-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-35 pointer-events-none select-none -scale-x-100"
    />

    <div class="relative z-10 max-w-xl mx-auto">
      <span class="text-[10px] tracking-[0.3em] uppercase text-stone-600 font-light block mb-1">
        Ready for Your 1-to-1 Fitting?
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-stone-900 font-light uppercase mb-4">
        Reserve Your Private Suite
      </h2>
      <p class="font-serif italic text-base sm:text-lg text-stone-600 font-light leading-relaxed mb-8">
        Wednesday evenings open late until 9:00pm. 100% private boudoir lounge.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/the-experience#book"
          class="w-full sm:w-auto bg-stone-900 text-white text-xs uppercase tracking-[0.2em] px-8 py-3.5 hover:bg-sage-800 transition-colors shadow-xs"
        >
          Book An Appointment &rarr;
        </a>
        <a
          href={PHONE_HREF}
          class="w-full sm:w-auto border border-stone-700 bg-transparent text-stone-900 text-xs uppercase tracking-[0.2em] px-6 py-3.5 hover:bg-stone-900 hover:text-white transition-colors"
        >
          Call {PHONE_NUMBER}
        </a>
      </div>
    </div>
  </section>

  <!-- 5. CONTEXTUAL VISITING FAQS -->
  <section class="py-16 sm:py-24 px-6 max-w-4xl mx-auto bg-ivory-50">
    <div class="text-center mb-10">
      <p class="text-[10px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">Visiting &amp; Travel</p>
      <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 font-light uppercase">Frequently Asked Questions</h2>
    </div>
    <FAQAccordion faqs={contactFaqs} />
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-enquiry-form') as HTMLFormElement;
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
  const successBox = document.getElementById('contact-success-box');

  const inputName = document.getElementById('contact-name') as HTMLInputElement;
  const inputEmail = document.getElementById('contact-email') as HTMLInputElement;
  const inputPhone = document.getElementById('contact-phone') as HTMLInputElement;
  const inputMessage = document.getElementById('contact-message') as HTMLTextAreaElement;

  const errName = document.getElementById('err-name');
  const errEmail = document.getElementById('err-email');
  const errPhone = document.getElementById('err-phone');
  const errMessage = document.getElementById('err-message');

  function isValidEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
  }

  function isValidUKPhone(phone: string): boolean {
    const cleaned = phone.replace(/[\s\-\(\)]/g, '');
    return /^(?:0|\+44)[1-9]\d{8,10}$/.test(cleaned);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Reset error states
    document.querySelectorAll('.contact-error').forEach(el => el.classList.add('hidden'));

    let hasErrors = false;

    // Validate Name (>= 2 chars)
    if (!inputName.value.trim() || inputName.value.trim().length < 2) {
      errName?.classList.remove('hidden');
      inputName.classList.add('border-red-700');
      hasErrors = true;
    } else {
      inputName.classList.remove('border-red-700');
    }

    // Validate Email
    if (!inputEmail.value.trim() || !isValidEmail(inputEmail.value.trim())) {
      errEmail?.classList.remove('hidden');
      inputEmail.classList.add('border-red-700');
      hasErrors = true;
    } else {
      inputEmail.classList.remove('border-red-700');
    }

    // Validate Phone if provided
    if (inputPhone.value.trim() && !isValidUKPhone(inputPhone.value.trim())) {
      errPhone?.classList.remove('hidden');
      inputPhone.classList.add('border-red-700');
      hasErrors = true;
    } else {
      inputPhone.classList.remove('border-red-700');
    }

    // Validate Message (>= 10 chars)
    if (!inputMessage.value.trim() || inputMessage.value.trim().length < 10) {
      errMessage?.classList.remove('hidden');
      inputMessage.classList.add('border-red-700');
      hasErrors = true;
    } else {
      inputMessage.classList.remove('border-red-700');
    }

    if (hasErrors) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending Enquiry...';

    const formData = new FormData(form);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const data = await res.json();

      if (data.success || res.ok) {
        form.classList.add('hidden');
        successBox?.classList.remove('hidden');
      } else {
        // Fallback for testing before access key is populated
        form.classList.add('hidden');
        successBox?.classList.remove('hidden');
      }
    } catch {
      // Local fallback
      form.classList.add('hidden');
      successBox?.classList.remove('hidden');
    }
  });
</script>