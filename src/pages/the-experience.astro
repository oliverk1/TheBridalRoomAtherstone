---
// src/pages/the-experience.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingEngine from '../components/ui/BookingEngine.astro';
import QuoteTicker from '../components/ui/QuoteTicker.astro';
import EtiquetteTicker from '../components/ui/EtiquetteTicker.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';

// Pull FAQs dynamically from settings JSON (managed via Decap CMS)
import faqsData from '../content/settings/faqs.json';
const experienceFaqs = faqsData.experienceFaqs;

const specialFeatures = [
  {
    id: "special-card-0",
    title: "The Boudoir Suite",
    badge: "100% Exclusivity",
    image: "/images/experience-boudoir.webp",
    alt: "Private bridal boudoir styling suite with French Louis chairs at The Bridal Room Atherstone",
    description: "Plush velvet seating, French Louis chairs, and soft ambient lighting. Your loved ones relax with refreshments while you step into each gown in complete privacy.",
    footerHighlight: "No Outside Spectators • Just You"
  },
  {
    id: "special-card-1",
    title: "Raised Pedestals & Mirrors",
    badge: "360° Perspective",
    image: "/images/experience-pedestal.webp",
    alt: "Raised viewing pedestal showing full cathedral train drape at The Bridal Room",
    description: "Raised viewing podiums allow cathedral trains, lace hems, and bustles to drape naturally. Full-length triple mirrors let you see every angle as you walk and turn.",
    footerHighlight: "Expert Pinning & Clipping"
  },
  {
    id: "special-card-2",
    title: "Prosecco & Afternoon Tea",
    badge: "Luxury Upgrade",
    image: "/images/experience-afternoon-tea.webp",
    alt: "Chilled prosecco and sweet treats afternoon tea bridal appointment",
    description: "Turn your search into an unforgettable celebration. Enjoy 2 full hours of styling with chilled prosecco, artisan sweet treats, and a £75 voucher credited to your dress.",
    footerHighlight: "Includes £75 Gown Voucher"
  }
];
---

<BaseLayout
  title="Private Bridal Appointments & Fittings | The Bridal Room Atherstone"
  description="Experience an intimate 1-to-1 bridal styling appointment in Warwickshire. 100% private boudoir suites, VIB afternoon tea with prosecco, and bespoke styling advice from Vicky & Sam."
  faqs={experienceFaqs}
>
  <!-- 1. EDITORIAL HEADER -->
  <section class="bg-sage-100 border-b border-sage-200 py-16 sm:py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="flex items-center justify-center gap-3 text-[10px] tracking-[0.35em] text-stone-600 uppercase font-light mb-3">
        <span class="w-8 h-px bg-stone-400"></span>
        1-to-1 Private Boutique Hire
        <span class="w-8 h-px bg-stone-400"></span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl uppercase font-light text-stone-900 tracking-wide mb-4">
        The Boutique Experience
      </h1>
      <p class="font-serif italic text-base sm:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed">
        French Louis chairs, crystal chandeliers, chilled prosecco, and an unhurried sanctuary tailored entirely to finding your dream dress.
      </p>
    </div>
  </section>

  <!-- 2. WHAT MAKES OUR FITTINGS SPECIAL -->
  <section class="py-20 sm:py-28 px-6 lg:px-12 bg-ivory-50 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <div class="flex items-center justify-center gap-3 text-[10px] tracking-[0.3em] text-stone-500 uppercase font-light mb-2">
          <span class="w-6 h-px bg-stone-300"></span>
          Exclusive Showroom Hire
          <span class="w-6 h-px bg-stone-300"></span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light text-stone-900 uppercase leading-tight">
          What Makes Our Fittings Special
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 font-light mt-3 leading-relaxed">
          No shared mirrors, no competing voices, and no rush. When you step inside on Station Street, the boutique is locked exclusively for you.
        </p>
      </div>

      <div
        id="special-track"
        class="flex md:grid md:grid-cols-3 gap-6 lg:gap-8 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pt-2 pb-6 -mx-6 px-8 md:mx-0 md:px-0 items-stretch"
      >
        {specialFeatures.map((feat) => (
          <div
            id={feat.id}
            class="w-[82vw] max-w-[320px] xs:w-[290px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-white border border-stone-200/90 shadow-xs flex flex-col group hover:border-stone-400 hover:shadow-md transition-all duration-300 overflow-hidden rounded-xs"
          >
            <div class="aspect-4/3 overflow-hidden bg-stone-100 relative">
              <img
                src={feat.image}
                alt={feat.alt}
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <span class="absolute top-3 left-3 bg-stone-900/80 text-white text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 backdrop-blur-xs font-medium">
                {feat.badge}
              </span>
            </div>
            <div class="p-6 sm:p-7 flex flex-col flex-1">
              <h3 class="font-serif text-xl uppercase text-stone-900 font-light mb-2">{feat.title}</h3>
              <p class="text-xs text-stone-600 font-light leading-relaxed mb-4 flex-1">
                {feat.description}
              </p>
              <span class="text-[10px] uppercase tracking-widest text-sage-900 font-medium pt-3 border-t border-stone-100">
                {feat.footerHighlight}
              </span>
            </div>
          </div>
        ))}
      </div>

      <div class="flex md:hidden justify-center items-center gap-2 mt-2" id="special-dots">
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="0" aria-label="Feature 1"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-sage-800 w-4" data-index="1" aria-label="Feature 2"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="2" aria-label="Feature 3"></button>
      </div>

    </div>
  </section>

  <!-- 3. REAL BRIDE QUOTES TICKER (Directly Below Picture Cards) -->
  <QuoteTicker />

  <!-- 4. EMBEDDED NATIVE BOOKING ENGINE (Decorated with Leaf SVGs) -->
  <section class="relative bg-sage-200 py-16 sm:py-24 px-6 border-b border-sage-300 overflow-hidden">
    
    <img
      src="/images/leaf.svg"
      alt=""
      aria-hidden="true"
      class="absolute left-2 sm:left-6 lg:left-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-30 pointer-events-none select-none"
    />
    <img
      src="/images/leaf.svg"
      alt=""
      aria-hidden="true"
      class="absolute right-2 sm:right-6 lg:right-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-30 pointer-events-none select-none -scale-x-100"
    />

    <div class="relative z-10 max-w-4xl mx-auto text-center mb-10">
      <p class="text-[10px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">Live Availability</p>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-stone-900 font-light uppercase">Reserve Your Private Suite</h2>
      <p class="text-xs text-stone-600 font-light mt-2 max-w-md mx-auto">
        Wednesday evenings available up to 9:00pm. 100% private boudoir lounge.
      </p>
    </div>

    <div class="relative z-10">
      <BookingEngine />
    </div>
  </section>

  <!-- 5. BOUTIQUE ETIQUETTE & VISITING ADVICE: BLENDED TICKER (No White Cards) -->
  <EtiquetteTicker />

  <!-- 6. CONTEXTUAL EXPERIENCE FAQS -->
  <section class="py-16 sm:py-24 px-6 max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <p class="text-[10px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">Helpful Guidance</p>
      <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 font-light uppercase">Appointment Questions</h2>
    </div>
    <FAQAccordion faqs={experienceFaqs} />
  </section>
</BaseLayout>

<script>
  function centerTrackChild(track: HTMLElement | null, childIndex: number) {
    if (!track || window.innerWidth >= 1024) return;
    const child = track.children[childIndex] as HTMLElement;
    if (!child) return;

    const trackWidth = track.clientWidth;
    const childWidth = child.offsetWidth;
    const childLeft = child.offsetLeft;
    track.scrollLeft = childLeft - (trackWidth - childWidth) / 2;
  }

  function setupMobileCarousel(trackId: string, dotsId: string, defaultCenterIndex = 0) {
    const track = document.getElementById(trackId);
    const dots = document.querySelectorAll(`#${dotsId} button`);

    if (track && dots.length > 0) {
      const initCenter = () => centerTrackChild(track, defaultCenterIndex);
      requestAnimationFrame(initCenter);
      window.addEventListener('load', initCenter);

      track.addEventListener('scroll', () => {
        const scrollLeft = track.scrollLeft;
        const cardWidth = track.firstElementChild?.clientWidth || 1;
        const activeIdx = Math.min(
          dots.length - 1,
          Math.max(0, Math.round(scrollLeft / cardWidth))
        );

        dots.forEach((dot, idx) => {
          if (idx === activeIdx) {
            dot.classList.add('bg-sage-800', 'w-4');
            dot.classList.remove('bg-stone-300', 'w-2');
          } else {
            dot.classList.remove('bg-sage-800', 'w-4');
            dot.classList.add('bg-stone-300', 'w-2');
          }
        });
      }, { passive: true });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = Number(dot.getAttribute('data-index') || 0);
          centerTrackChild(track, idx);
        });
      });
    }
  }

  // Setup mobile carousel for Special Features cards
  setupMobileCarousel('special-track', 'special-dots', 1);
</script>