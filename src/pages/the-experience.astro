---
// src/pages/the-experience.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingEngine from '../components/ui/BookingEngine.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';

const experienceFaqs = [
  {
    question: "What underwear should I wear to my bridal fitting?",
    answer: "We strongly recommend wearing seamless, nude-toned underwear. A nude strapless bra is helpful, though many of our Justin Alexander and Sincerity gowns feature built-in boning and inner corsetry, meaning most brides find they don't need a bra at all. We provide pedestals, so feel free to bring heels of a similar height to what you plan to wear on your wedding day."
  },
  {
    question: "Can I wear fake tan to my appointment?",
    answer: "To preserve our pristine sample gowns and delicate silks, we kindly ask that you do not wear fresh fake tan, heavy bronzers, or freshly applied body oils on the day of your appointment."
  },
  {
    question: "Why do you recommend a maximum of 3 guests?",
    answer: "Our boudoir styling suites are intimate, luxurious spaces designed to keep you relaxed. Over 15 years in bridal styling, we've found that having 2 to 3 trusted VIPs (mothers, sisters, maids of honour) provides loving, constructive support without overwhelming you with competing opinions."
  },
  {
    question: "Can I bring young children to the boutique?",
    answer: "We want your appointment to be entirely about you. Bridal boutiques contain pins, delicate laces, and high pedestals, which can be stressful for toddlers. While babies in prams are welcome, we generally suggest leaving young children with loved ones so you can sip tea, relax, and fully enjoy the moment."
  },
  {
    question: "What is your cancellation or rescheduling policy?",
    answer: "We understand plans change. For our complimentary Signature styling appointments, we kindly request at least 48 hours notice so we can offer the private suite to another bride on our waiting list. For VIB Afternoon Tea appointments, rescheduling is available with 72 hours notice."
  }
];

const specialFeatures = [
  {
    id: "special-card-0",
    title: "The Boudoir Suite",
    badge: "100% Exclusivity",
    image: "/images/experience-boudoir.webp",
    alt: "Private bridal boudoir styling suite with French Louis chairs at The Bridal Room Atherstone",
    description: "Plush velvet seating, French Louis chairs, and soft ambient lighting. Your loved ones relax with refreshments while you step into each gown in complete privacy.",
    footerHighlight: "No Outside Spectators • Just You"
  },
  {
    id: "special-card-1",
    title: "Raised Pedestals & Mirrors",
    badge: "360° Perspective",
    image: "/images/experience-pedestal.webp",
    alt: "Raised viewing pedestal showing full cathedral train drape at The Bridal Room",
    description: "Raised viewing podiums allow cathedral trains, lace hems, and bustles to drape naturally. Full-length triple mirrors let you see every angle as you walk and turn.",
    footerHighlight: "Expert Pinning & Clipping"
  },
  {
    id: "special-card-2",
    title: "Prosecco & Afternoon Tea",
    badge: "Luxury Upgrade",
    image: "/images/experience-afternoon-tea.webp",
    alt: "Chilled prosecco and sweet treats afternoon tea bridal appointment",
    description: "Turn your search into an unforgettable celebration. Enjoy 2 full hours of styling with chilled prosecco, artisan sweet treats, and a £75 voucher credited to your dress.",
    footerHighlight: "Includes £75 Gown Voucher"
  }
];

const brideStories = [
  {
    id: "story-card-0",
    quote: "Having the entire shop locked just for my mum, sister and me made all the difference. No other brides watching, no rush. Vicky knew exactly what suited my figure within ten minutes.",
    bride: "Charlotte &bull; Justin Alexander Bride",
    date: "Warwickshire Wedding"
  },
  {
    id: "story-card-1",
    quote: "The VIB Afternoon Tea was the highlight of our wedding planning! The prosecco and cakes were delicious, and having the £75 credited straight to my dream dress was an amazing touch.",
    bride: "Sophie &bull; Sincerity Bridal Bride",
    date: "Staffordshire Wedding"
  },
  {
    id: "story-card-2",
    quote: "I was so nervous before my appointment as a size 16. Vicky and Sam made me feel so calm and beautiful. The pedestals and lighting showed off the train perfectly.",
    bride: "Eleanor &bull; Phoenix Gowns Bride",
    date: "Cotswolds Wedding"
  }
];

const etiquetteGuidelines = [
  {
    id: "etiquette-card-0",
    title: "Underwear",
    subtitle: "Nude & Seamless",
    description: "Nude, seamless underwear is best. Don't worry about special strapless bras—most gowns feature built-in inner corsetry and supportive boning."
  },
  {
    id: "etiquette-card-1",
    title: "Tan Policy",
    subtitle: "Protect The Gowns",
    description: "Please avoid freshly applied fake tan, tinted bronzers, or heavy body oils on appointment day to keep our designer sample gowns immaculate."
  },
  {
    id: "etiquette-card-2",
    title: "Pedestals & Heels",
    subtitle: "360° Viewing",
    description: "Raised pedestals are provided. Bring heels of a similar height to your wedding shoes to test the train drape. Outdoor shoes stay off the podiums."
  },
  {
    id: "etiquette-card-3",
    title: "Guest Numbers",
    subtitle: "Intimate Circle",
    description: "We comfortably host up to 3 guests for Signature consultations and up to 4 for VIB Afternoon Tea sessions to ensure the focus remains on you."
  }
];
---

<BaseLayout
  title="The Private Bridal Experience & Fittings | The Bridal Room Atherstone"
  description="Experience an intimate 1-to-1 bridal styling appointment in Warwickshire. 100% private boudoir suites, VIB afternoon tea with prosecco, and bespoke styling advice from Vicky & Sam."
  faqs={experienceFaqs}
>
  <!-- 1. EDITORIAL HEADER -->
  <section class="bg-sage-100 border-b border-sage-200 py-16 sm:py-20 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="flex items-center justify-center gap-3 text-[10px] tracking-[0.35em] text-stone-600 uppercase font-light mb-3">
        <span class="w-8 h-px bg-stone-400"></span>
        1-to-1 Private Boutique Hire
        <span class="w-8 h-px bg-stone-400"></span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl uppercase font-light text-stone-900 tracking-wide mb-4">
        The Boutique Experience
      </h1>
      <p class="font-serif italic text-base sm:text-xl text-stone-600 max-w-2xl mx-auto leading-relaxed">
        French Louis chairs, crystal chandeliers, chilled prosecco, and an unhurried sanctuary tailored entirely to finding your dream dress.
      </p>
    </div>
  </section>

  <!-- 2. WHAT MAKES OUR FITTINGS SPECIAL -->
  <section class="py-20 sm:py-28 px-6 lg:px-12 bg-ivory-50 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <div class="flex items-center justify-center gap-3 text-[10px] tracking-[0.3em] text-stone-500 uppercase font-light mb-2">
          <span class="w-6 h-px bg-stone-300"></span>
          Exclusive Showroom Hire
          <span class="w-6 h-px bg-stone-300"></span>
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-light text-stone-900 uppercase leading-tight">
          What Makes Our Fittings Special
        </h2>
        <p class="text-xs sm:text-sm text-stone-600 font-light mt-3 leading-relaxed">
          No shared mirrors, no competing voices, and no rush. When you step inside on Station Street, the boutique is locked exclusively for you.
        </p>
      </div>

      <div
        id="special-track"
        class="flex md:grid md:grid-cols-3 gap-6 lg:gap-8 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pt-2 pb-6 -mx-6 px-8 md:mx-0 md:px-0 items-stretch"
      >
        {specialFeatures.map((feat) => (
          <div
            id={feat.id}
            class="w-[82vw] max-w-[320px] xs:w-[290px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-white border border-stone-200/90 shadow-xs flex flex-col group hover:border-stone-400 hover:shadow-md transition-all duration-300 overflow-hidden rounded-xs"
          >
            <div class="aspect-4/3 overflow-hidden bg-stone-100 relative">
              <img
                src={feat.image}
                alt={feat.alt}
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <span class="absolute top-3 left-3 bg-stone-900/80 text-white text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 backdrop-blur-xs font-medium">
                {feat.badge}
              </span>
            </div>
            <div class="p-6 sm:p-7 flex flex-col flex-1">
              <h3 class="font-serif text-xl uppercase text-stone-900 font-light mb-2">{feat.title}</h3>
              <p class="text-xs text-stone-600 font-light leading-relaxed mb-4 flex-1">
                {feat.description}
              </p>
              <span class="text-[10px] uppercase tracking-widest text-sage-900 font-medium pt-3 border-t border-stone-100">
                {feat.footerHighlight}
              </span>
            </div>
          </div>
        ))}
      </div>

      <div class="flex md:hidden justify-center items-center gap-2 mt-2" id="special-dots">
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="0" aria-label="Feature 1"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-sage-800 w-4" data-index="1" aria-label="Feature 2"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="2" aria-label="Feature 3"></button>
      </div>

    </div>
  </section>

  <!-- 3. CONSULTATION TIERS -->
  <section id="tiers" class="scroll-mt-28 py-20 sm:py-28 px-6 lg:px-12 bg-ivory-100/70 border-y border-stone-200 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <p class="text-[10px] tracking-[0.3em] uppercase text-stone-500 font-light mb-2">Private Appointments</p>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-stone-900 font-light uppercase">Select Your Appointment Style</h2>
        <p class="text-xs sm:text-sm text-stone-600 font-light mt-2">
          Click any consultation tier below to jump directly to our real-time calendar scheduler.
        </p>
      </div>

      <div
        id="tiers-track-exp"
        class="flex md:grid md:grid-cols-3 gap-6 lg:gap-8 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pt-7 pb-6 -mx-6 px-8 md:mx-0 md:px-0 items-stretch"
      >
        
        <!-- Tier 1: Signature -->
        <div
          id="exp-tier-0"
          class="w-[82vw] max-w-[320px] xs:w-[290px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-white border border-stone-200 p-7 sm:p-8 flex flex-col justify-between shadow-xs hover:border-stone-400 transition-all rounded-xs"
        >
          <div>
            <div class="flex justify-between items-baseline mb-2">
              <span class="text-[10px] tracking-[0.25em] uppercase text-stone-500 block">Classic Consultation</span>
              <span class="text-[10px] uppercase text-stone-400 font-light">1.5 Hours</span>
            </div>
            <h3 class="font-serif text-2xl uppercase text-stone-900 mb-2 font-light">Signature Suite</h3>
            <div class="mb-4">
              <span class="text-base font-medium text-stone-900">Complimentary / £0</span>
              <span class="text-[10px] text-stone-500 block">Free 1-to-1 styling session</span>
            </div>
            <p class="text-xs text-stone-600 font-light leading-relaxed mb-6">
              Our traditional 1-to-1 appointment. Explore our curated rails with honest, dedicated advice from Vicky and Samantha. Bring up to 3 guests.
            </p>
            <ul class="space-y-2 text-xs text-stone-500 font-light border-t border-stone-100 pt-4 mb-6">
              <li class="flex items-center gap-2">&bull; Exclusive boutique hire</li>
              <li class="flex items-center gap-2">&bull; Up to 3 guests welcome</li>
              <li class="flex items-center gap-2">&bull; Hot tea &amp; refreshments</li>
            </ul>
          </div>
          <button
            type="button"
            data-select-tier="Signature Bridal Styling"
            class="tier-trigger-btn block w-full text-center border border-stone-800 py-3 text-[10px] uppercase tracking-[0.2em] text-stone-900 hover:bg-stone-900 hover:text-white transition-colors cursor-pointer"
          >
            Select Signature &rarr;
          </button>
        </div>

        <!-- Tier 2: VIB Afternoon Tea -->
        <div
          id="exp-tier-1"
          class="w-[82vw] max-w-[320px] xs:w-[290px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-sage-50 border-2 border-sage-800 p-7 sm:p-8 flex flex-col justify-between shadow-md relative rounded-xs"
        >
          <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-sage-800 text-white text-[9px] uppercase tracking-[0.2em] px-3.5 py-1 font-medium shadow-sm whitespace-nowrap z-10">
            Most Popular Experience
          </span>
          <div>
            <div class="flex justify-between items-baseline mb-2">
              <span class="text-[10px] tracking-[0.25em] uppercase text-stone-600 block">Luxury Upgrade</span>
              <span class="text-[10px] uppercase text-stone-600 font-semibold">2.0 Hours</span>
            </div>
            <h3 class="font-serif text-2xl uppercase text-stone-900 mb-2 font-light">VIB Afternoon Tea</h3>
            <div class="mb-4">
              <span class="text-base font-semibold text-sage-900">£50 Deposit</span>
              <span class="text-[10px] text-sage-800 block font-medium">Includes £75 Gown Voucher Credited</span>
            </div>
            <p class="text-xs text-stone-600 font-light leading-relaxed mb-6">
              Turn finding the dress into a celebration. Includes chilled prosecco, artisan sweet treats, 2 unhurried hours of styling, and a £75 voucher toward your gown.
            </p>
            <ul class="space-y-2 text-xs text-stone-600 font-light border-t border-stone-200/80 pt-4 mb-6">
              <li class="flex items-center gap-2">&bull; <strong>£75 voucher</strong> credited to your gown</li>
              <li class="flex items-center gap-2">&bull; Chilled prosecco &amp; sweet treats</li>
              <li class="flex items-center gap-2">&bull; Extended 2-hour styling</li>
              <li class="flex items-center gap-2">&bull; Up to 4 guests welcome</li>
            </ul>
          </div>
          <button
            type="button"
            data-select-tier="VIB Afternoon Tea Experience"
            class="tier-trigger-btn block w-full text-center bg-sage-800 text-white py-3 text-[10px] uppercase tracking-[0.2em] hover:bg-stone-900 transition-colors shadow-xs cursor-pointer font-medium"
          >
            Select VIB Suite &rarr;
          </button>
        </div>

        <!-- Tier 3: Accessories -->
        <div
          id="exp-tier-2"
          class="w-[82vw] max-w-[320px] xs:w-[290px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-white border border-stone-200 p-7 sm:p-8 flex flex-col justify-between shadow-xs hover:border-stone-400 transition-all rounded-xs"
        >
          <div>
            <div class="flex justify-between items-baseline mb-2">
              <span class="text-[10px] tracking-[0.25em] uppercase text-stone-500 block">Finishing Touches</span>
              <span class="text-[10px] uppercase text-stone-400 font-light">45 Minutes</span>
            </div>
            <h3 class="font-serif text-2xl uppercase text-stone-900 mb-2 font-light">Veils &amp; Accessories</h3>
            <div class="mb-4">
              <span class="text-base font-medium text-stone-900">Complimentary</span>
              <span class="text-[10px] text-stone-500 block">Free accessory styling session</span>
            </div>
            <p class="text-xs text-stone-600 font-light leading-relaxed mb-6">
              Already found your gown and looking for the perfect veil or crown? Bring your dress with you or pair accessories alongside our showroom samples.
            </p>
            <ul class="space-y-2 text-xs text-stone-500 font-light border-t border-stone-100 pt-4 mb-6">
              <li class="flex items-center gap-2">&bull; Cathedral &amp; bespoke veil matching</li>
              <li class="flex items-center gap-2">&bull; Tiaras, combs, and jewellery</li>
              <li class="flex items-center gap-2">&bull; Up to 2 guests welcome</li>
            </ul>
          </div>
          <button
            type="button"
            data-select-tier="Accessories & Veil Styling"
            class="tier-trigger-btn block w-full text-center border border-stone-800 py-3 text-[10px] uppercase tracking-[0.2em] text-stone-900 hover:bg-stone-900 hover:text-white transition-colors cursor-pointer"
          >
            Select Accessories &rarr;
          </button>
        </div>

      </div>

      <div class="flex md:hidden justify-center items-center gap-2 mt-2" id="tiers-dots-exp">
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="0" aria-label="Tier 1"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-sage-800 w-4" data-index="1" aria-label="Tier 2"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="2" aria-label="Tier 3"></button>
      </div>

    </div>
  </section>

  <!-- 4. REAL BRIDE PROOF -->
  <section class="py-20 sm:py-24 px-6 lg:px-12 bg-ivory-50 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-xl mx-auto mb-12 sm:mb-16">
        <p class="text-[10px] tracking-[0.3em] uppercase text-stone-500 font-light mb-1">Loved by Warwickshire Brides</p>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-light uppercase">Real Brides &bull; Real Memories</h2>
      </div>

      <div
        id="stories-track"
        class="flex md:grid md:grid-cols-3 gap-6 lg:gap-8 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pt-2 pb-6 -mx-6 px-8 md:mx-0 md:px-0 items-stretch"
      >
        {brideStories.map((item) => (
          <div
            id={item.id}
            class="w-[82vw] max-w-[320px] xs:w-[290px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-white p-7 sm:p-8 border border-stone-200/90 shadow-xs flex flex-col justify-between rounded-xs relative"
          >
            <svg class="w-6 h-6 text-sage-800 mb-4 fill-current opacity-30" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
            <p class="font-serif text-sm sm:text-[15px] text-stone-800 font-light leading-relaxed italic mb-6">
              "{item.quote}"
            </p>
            <div class="pt-4 border-t border-stone-100">
              <strong class="text-xs uppercase tracking-wider text-stone-900 block font-medium" set:html={item.bride}></strong>
              <span class="text-[10px] text-stone-400 font-light block mt-0.5">{item.date}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="flex md:hidden justify-center items-center gap-2 mt-2" id="stories-dots">
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="0" aria-label="Quote 1"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-sage-800 w-4" data-index="1" aria-label="Quote 2"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="2" aria-label="Quote 3"></button>
      </div>

    </div>
  </section>

  <!-- 5. EMBEDDED NATIVE BOOKING ENGINE -->
  <section class="relative bg-sage-200 py-16 sm:py-24 px-6 border-y border-sage-300 overflow-hidden">
    
    <img
      src="/images/leaf.svg"
      alt=""
      aria-hidden="true"
      class="absolute left-2 sm:left-6 lg:left-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-30 pointer-events-none select-none"
    />
    <img
      src="/images/leaf.svg"
      alt=""
      aria-hidden="true"
      class="absolute right-2 sm:right-6 lg:right-12 top-1/2 -translate-y-1/2 w-24 sm:w-36 lg:w-48 opacity-30 pointer-events-none select-none -scale-x-100"
    />

    <div class="relative z-10 max-w-4xl mx-auto text-center mb-10">
      <p class="text-[10px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">Live Availability</p>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-stone-900 font-light uppercase">Reserve Your Private Suite</h2>
      <p class="text-xs text-stone-600 font-light mt-2 max-w-md mx-auto">
        Wednesday evenings available up to 9:00pm. 100% private boudoir lounge.
      </p>
    </div>

    <div class="relative z-10">
      <BookingEngine />
    </div>
  </section>

  <!-- 6. BOUTIQUE ETIQUETTE & VISITING ADVICE -->
  <section class="py-20 sm:py-28 px-6 lg:px-12 bg-ivory-100/70 border-b border-stone-200 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <p class="text-[10px] tracking-[0.3em] uppercase text-stone-500 font-light mb-2">Visiting Preparation</p>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 font-light uppercase">Boutique Etiquette &amp; Advice</h2>
        <p class="text-xs sm:text-sm text-stone-600 font-light mt-2">
          Helpful guidance to ensure you and your loved ones have the most serene, memorable experience.
        </p>
      </div>

      <div
        id="etiquette-track"
        class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory scrollbar-none pt-2 pb-6 -mx-6 px-8 md:mx-0 md:px-0 items-stretch"
      >
        {etiquetteGuidelines.map((item) => (
          <div
            id={item.id}
            class="w-[78vw] max-w-[290px] xs:w-[260px] md:w-auto md:max-w-none snap-center shrink-0 md:shrink bg-white p-6 sm:p-7 border border-stone-200/90 shadow-2xs rounded-xs flex flex-col justify-between hover:border-stone-400 transition-all"
          >
            <div>
              <div class="w-11 h-11 rounded-full bg-sage-100 flex items-center justify-center text-sage-900 mb-5 shadow-2xs">
                {item.id === "etiquette-card-0" && (
                  <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 4c1.5 2 3.5 2.5 5 1 1.5 1.5 3.5 1 5-1l1 6c-.5 3-2 5-2 9H8c0-4-1.5-6-2-9l1-6z" />
                    <path d="M12 5.5V20" />
                    <path d="M9.5 8c.5 3 1 6.5 1 12" />
                    <path d="M14.5 8c-.5 3-1 6.5-1 12" />
                  </svg>
                )}

                {item.id === "etiquette-card-1" && (
                  <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v2m0 16v2m10-10h-2M4 12H2m15.07-7.07l-1.41 1.41M6.34 17.66l-1.41 1.41m14.14 0l-1.41-1.41M6.34 6.34L4.93 4.93M12 6a6 6 0 100 12 6 6 0 000-12z" />
                  </svg>
                )}

                {item.id === "etiquette-card-2" && (
                  <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 16h2.5c2 0 3.5-1 5-3.5L14 9c.8-1.3 2-2 3.5-2H20v3.5c0 1.5-.8 3-2.2 3.8L15 16" />
                    <line x1="18.5" y1="10.5" x2="18.5" y2="16" />
                    <line x1="2" y1="19" x2="22" y2="19" stroke-width="2" />
                    <line x1="4" y1="21.5" x2="20" y2="21.5" />
                  </svg>
                )}

                {item.id === "etiquette-card-3" && (
                  <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="7" r="2.5" />
                    <path d="M9 19v-2c0-1.7 1.3-3 3-3s3 1.3 3 3v2" />
                    <circle cx="6" cy="9" r="2" />
                    <path d="M3 19v-1.5c0-1.4 1-2.5 2.5-2.5.8 0 1.6.4 2 1" />
                    <circle cx="18" cy="9" r="2" />
                    <path d="M21 19v-1.5c0-1.4-1-2.5-2.5-2.5-.8 0-1.6.4-2 1" />
                  </svg>
                )}
              </div>

              <span class="text-[9px] uppercase tracking-[0.2em] text-sage-900 font-semibold block mb-1">
                {item.subtitle}
              </span>
              <h4 class="font-serif text-xl uppercase text-stone-900 mb-2.5 font-light">
                {item.title}
              </h4>
              <p class="text-xs text-stone-600 font-light leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="flex md:hidden justify-center items-center gap-2 mt-2" id="etiquette-dots">
        <button class="h-2 rounded-full transition-all duration-300 bg-sage-800 w-4" data-index="0" aria-label="Guideline 1"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="1" aria-label="Guideline 2"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="2" aria-label="Guideline 3"></button>
        <button class="h-2 rounded-full transition-all duration-300 bg-stone-300 w-2" data-index="3" aria-label="Guideline 4"></button>
      </div>

    </div>
  </section>

  <!-- 7. CONTEXTUAL EXPERIENCE FAQS -->
  <section class="py-16 sm:py-24 px-6 max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <p class="text-[10px] tracking-[0.3em] uppercase text-stone-600 font-light mb-2">Helpful Guidance</p>
      <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 font-light uppercase">Appointment Questions</h2>
    </div>
    <FAQAccordion faqs={experienceFaqs} />
  </section>
</BaseLayout>

<script>
  function centerTrackChild(track: HTMLElement | null, childIndex: number) {
    if (!track || window.innerWidth >= 1024) return;
    const child = track.children[childIndex] as HTMLElement;
    if (!child) return;

    const trackWidth = track.clientWidth;
    const childWidth = child.offsetWidth;
    const childLeft = child.offsetLeft;
    track.scrollLeft = childLeft - (trackWidth - childWidth) / 2;
  }

  function setupMobileCarousel(trackId: string, dotsId: string, defaultCenterIndex = 0) {
    const track = document.getElementById(trackId);
    const dots = document.querySelectorAll(`#${dotsId} button`);

    if (track && dots.length > 0) {
      const initCenter = () => centerTrackChild(track, defaultCenterIndex);
      requestAnimationFrame(initCenter);
      window.addEventListener('load', initCenter);

      track.addEventListener('scroll', () => {
        const scrollLeft = track.scrollLeft;
        const cardWidth = track.firstElementChild?.clientWidth || 1;
        const activeIdx = Math.min(
          dots.length - 1,
          Math.max(0, Math.round(scrollLeft / cardWidth))
        );

        dots.forEach((dot, idx) => {
          if (idx === activeIdx) {
            dot.classList.add('bg-sage-800', 'w-4');
            dot.classList.remove('bg-stone-300', 'w-2');
          } else {
            dot.classList.remove('bg-sage-800', 'w-4');
            dot.classList.add('bg-stone-300', 'w-2');
          }
        });
      }, { passive: true });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = Number(dot.getAttribute('data-index') || 0);
          centerTrackChild(track, idx);
        });
      });
    }
  }

  setupMobileCarousel('special-track', 'special-dots', 1);
  setupMobileCarousel('tiers-track-exp', 'tiers-dots-exp', 1);
  setupMobileCarousel('stories-track', 'stories-dots', 1);
  setupMobileCarousel('etiquette-track', 'etiquette-dots', 0);

  // Dynamic Scroll Helper taking into account the sticky header
  function scrollToScheduler() {
    const bookTarget = document.getElementById('book');
    if (!bookTarget) return;
    const header = document.querySelector('header');
    const headerOffset = header ? header.offsetHeight : 80;
    const targetTop = bookTarget.getBoundingClientRect().top + window.scrollY - (headerOffset + 24);
    window.scrollTo({ top: Math.max(0, targetTop), behavior: 'smooth' });
  }

  // Selects Tier AND advances directly to Step 2 (Calendar)
  function selectTierAndOpenCalendar(tierName: string) {
    const radio = document.querySelector(`input[name="experience"][value="${tierName}"]`) as HTMLInputElement;
    if (radio) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change', { bubbles: true }));
    }

    // Trigger Step 2 (Calendar) directly inside BookingEngine
    const btnToStep2 = document.getElementById('btn-to-step-2') as HTMLButtonElement;
    if (btnToStep2) {
      btnToStep2.click();
    }
  }

  // Handle URL Query Params on Load (e.g. ?tier=VIB+Afternoon+Tea+Experience)
  const urlParams = new URLSearchParams(window.location.search);
  const tierParam = urlParams.get('tier');
  if (tierParam && !urlParams.get('booking')) {
    setTimeout(() => {
      selectTierAndOpenCalendar(tierParam);
      scrollToScheduler();
    }, 150);
  }

  // Handle On-Page Tier Card Button Clicks
  document.querySelectorAll('.tier-trigger-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const targetTier = (btn as HTMLElement).dataset.selectTier;
      if (targetTier) {
        selectTierAndOpenCalendar(targetTier);
        setTimeout(scrollToScheduler, 50);
      }
    });
  });
</script>