---
// src/components/ui/DressFilter.astro
const designers = [
  "All Designers",
  "Justin Alexander",
  "Sincerity Bridal",
  "Adore by Justin Alexander",
  "Phoenix Gowns"
];

const categories = [
  "All Gowns",
  "Made to Order (£1,200 - £2,500)",
  "Sample Sale Rail (£250 - £900)",
  "Accessories"
];
---

<div class="bg-sage-100 border border-sage-200 p-5 sm:p-6 mb-10">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-5">
    
    <!-- Category Tabs -->
    <div class="flex flex-wrap items-center gap-2" id="category-filters">
      {categories.map((cat, i) => (
        <button
          type="button"
          data-category={cat}
          class={`filter-category-btn text-[11px] uppercase tracking-[0.18em] px-4 py-2 border transition-all cursor-pointer ${
            i === 0
              ? 'bg-stone-900 text-white border-stone-900'
              : 'bg-white text-stone-700 border-stone-300 hover:border-stone-900'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Designer Dropdown Filter -->
    <div class="flex items-center gap-3">
      <label for="designer-select" class="text-[11px] uppercase tracking-[0.2em] text-stone-600 whitespace-nowrap">
        Designer:
      </label>
      <select
        id="designer-select"
        class="bg-white border border-stone-300 text-stone-800 text-xs px-3 py-2 uppercase tracking-wider focus:outline-none focus:border-stone-900 cursor-pointer"
      >
        {designers.map(designer => (
          <option value={designer}>{designer}</option>
        ))}
      </select>
    </div>

  </div>

  <!-- Live Counter Status -->
  <div class="mt-4 pt-3 border-t border-sage-200/60 flex items-center justify-between text-xs text-stone-500 font-light">
    <span>Showing <strong id="visible-count" class="text-stone-800 font-medium">0</strong> dresses</span>
    <button id="reset-filters" class="hover:text-stone-900 underline text-[11px] uppercase tracking-wider cursor-pointer">
      Reset Filters
    </button>
  </div>
</div>

<script>
  let activeCategory = "All Gowns";
  let activeDesigner = "All Designers";

  const cards = document.querySelectorAll('.dress-card') as NodeListOf<HTMLElement>;
  const visibleCount = document.getElementById('visible-count');
  const catButtons = document.querySelectorAll('.filter-category-btn');
  const designerSelect = document.getElementById('designer-select') as HTMLSelectElement;
  const resetBtn = document.getElementById('reset-filters');

  function filterCards() {
    let count = 0;

    cards.forEach(card => {
      const cardCategory = card.dataset.category || "";
      const cardDesigner = card.dataset.designer || "";

      let matchesCat = activeCategory === "All Gowns" || cardCategory.includes(activeCategory.split(' ')[0]);
      let matchesDesigner = activeDesigner === "All Designers" || cardDesigner === activeDesigner;

      if (matchesCat && matchesDesigner) {
        card.style.display = "flex";
        count++;
      } else {
        card.style.display = "none";
      }
    });

    if (visibleCount) visibleCount.textContent = String(count);
  }

  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      catButtons.forEach(b => {
        b.classList.remove('bg-stone-900', 'text-white', 'border-stone-900');
        b.classList.add('bg-white', 'text-stone-700', 'border-stone-300');
      });
      btn.classList.remove('bg-white', 'text-stone-700', 'border-stone-300');
      btn.classList.add('bg-stone-900', 'text-white', 'border-stone-900');

      activeCategory = (btn as HTMLElement).dataset.category || "All Gowns";
      filterCards();
    });
  });

  designerSelect?.addEventListener('change', () => {
    activeDesigner = designerSelect.value;
    filterCards();
  });

  resetBtn?.addEventListener('click', () => {
    activeCategory = "All Gowns";
    activeDesigner = "All Designers";
    designerSelect.value = "All Designers";
    catButtons[0]?.dispatchEvent(new Event('click'));
  });

  document.addEventListener('DOMContentLoaded', filterCards);
</script>