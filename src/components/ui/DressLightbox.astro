---
// src/components/ui/DressLightbox.astro
---

<div
  id="global-dress-lightbox"
  class="fixed inset-0 z-60 bg-stone-950/85 backdrop-blur-xs hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-3 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-label="Maximised Dress View"
>
  <div
    id="lightbox-dialog"
    class="relative w-full max-w-4xl bg-ivory-50 border border-stone-300 shadow-2xl scale-95 transition-transform duration-300 overflow-hidden flex flex-col md:flex-row max-h-[92vh] rounded-xs"
  >
    <!-- Close Button (Top-Right of modal) -->
    <button
      id="lightbox-close-btn"
      type="button"
      class="absolute top-3 right-3 z-30 w-9 h-9 rounded-full bg-white/90 backdrop-blur-xs flex items-center justify-center text-stone-800 hover:text-black hover:bg-white shadow-md cursor-pointer transition-transform hover:scale-105"
      aria-label="Close Maximised View"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <!-- Left: Image Stage & Gallery Selector -->
    <div class="relative md:w-3/5 bg-stone-200 overflow-hidden flex flex-col items-center justify-between min-h-[340px] md:min-h-[580px] max-h-[52vh] md:max-h-[92vh]">
      <div class="w-full h-full flex items-center justify-center overflow-hidden">
        <img
          id="lightbox-main-img"
          src=""
          alt="Maximised Wedding Dress"
          class="w-full h-full object-cover object-top transition-opacity duration-300"
        />
      </div>

      <!-- Category Pill -->
      <span id="lightbox-badge" class="absolute top-4 left-4 z-20 bg-stone-900/85 text-white text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 backdrop-blur-xs font-medium">
        Made to Order
      </span>

      <!-- Multi-Image Thumbnail Gallery Bar -->
      <div id="lightbox-gallery-bar" class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 hidden items-center gap-2 bg-stone-900/80 backdrop-blur-xs px-3 py-1.5 rounded-full shadow-md max-w-[90%] overflow-x-auto">
        <!-- Thumbnails injected dynamically -->
      </div>
    </div>

    <!-- Right: Editorial Details (With pr-12 padding to avoid close-button collision) -->
    <div class="md:w-2/5 p-6 sm:p-8 bg-white flex flex-col justify-between overflow-y-auto">
      <div>
        <!-- pr-12 guarantees the silhouette text (e.g. 'A-Line') never collides with the close cross -->
        <div class="flex items-center justify-between mb-2 pr-12">
          <p id="lightbox-designer" class="text-[10px] tracking-[0.28em] uppercase text-stone-500 font-medium">Designer</p>
          <span id="lightbox-silhouette" class="text-[10px] tracking-wider uppercase text-stone-400 font-medium">Silhouette</span>
        </div>
        
        <h3 id="lightbox-title" class="font-serif text-2xl sm:text-3xl uppercase text-stone-900 font-light leading-snug mb-3 pr-8">
          Dress Title
        </h3>

        <div class="flex items-baseline gap-3 pb-4 mb-4 border-b border-stone-200">
          <span id="lightbox-price" class="font-serif text-xl text-sage-900 font-medium">£1,650</span>
          <span id="lightbox-sample-size" class="text-xs text-stone-500 font-light">Sample Size in Store</span>
        </div>

        <div class="space-y-3 text-xs text-stone-600 font-light leading-relaxed mb-6">
          <p id="lightbox-desc">
            Experience this gown in your own private boudoir styling suite at 65 Station Street, Atherstone.
          </p>
          <ul class="space-y-1.5 text-[11px] text-stone-500">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-800"></span>
              1-to-1 styling session with Vicky & Sam
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-800"></span>
              Orderable in UK sizes 2 through 32
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-800"></span>
              In-house bespoke seamstress fittings
            </li>
          </ul>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 border-t border-stone-100 flex flex-col gap-2.5">
        <a
          id="lightbox-book-btn"
          href="/the-experience#book"
          class="w-full text-center bg-stone-900 text-white py-3.5 px-4 text-xs uppercase tracking-[0.2em] hover:bg-sage-800 transition-colors shadow-xs"
        >
          Try This On in Boutique &rarr;
        </a>

        <button
          id="lightbox-wishlist-btn"
          type="button"
          class="w-full text-center border border-stone-300 py-3 px-4 text-xs uppercase tracking-[0.18em] text-stone-800 hover:border-stone-900 transition-colors cursor-pointer flex items-center justify-center gap-2"
        >
          <svg id="lightbox-heart-icon" class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
          <span id="lightbox-wishlist-text">Add to My Shortlist</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let activeDress: any = null;

  const modal = document.getElementById('global-dress-lightbox');
  const dialog = document.getElementById('lightbox-dialog');
  const closeBtn = document.getElementById('lightbox-close-btn');
  const mainImg = document.getElementById('lightbox-main-img') as HTMLImageElement;
  const badge = document.getElementById('lightbox-badge');
  const designerEl = document.getElementById('lightbox-designer');
  const silhouetteEl = document.getElementById('lightbox-silhouette');
  const titleEl = document.getElementById('lightbox-title');
  const priceEl = document.getElementById('lightbox-price');
  const sampleSizeEl = document.getElementById('lightbox-sample-size');
  const bookBtn = document.getElementById('lightbox-book-btn') as HTMLAnchorElement;
  const wishlistBtn = document.getElementById('lightbox-wishlist-btn');
  const heartIcon = document.getElementById('lightbox-heart-icon');
  const wishlistText = document.getElementById('lightbox-wishlist-text');
  const galleryBar = document.getElementById('lightbox-gallery-bar');

  function openLightbox(dress: any) {
    if (!modal || !mainImg) return;
    activeDress = dress;

    const allImages = [dress.image];
    if (dress.imageDetail && dress.imageDetail !== dress.image) {
      allImages.push(dress.imageDetail);
    }
    if (Array.isArray(dress.gallery)) {
      dress.gallery.forEach((g: string) => {
        if (g && !allImages.includes(g)) allImages.push(g);
      });
    }

    mainImg.src = allImages[0];
    mainImg.alt = `${dress.title} by ${dress.designer}`;

    if (designerEl) designerEl.textContent = dress.designer;
    if (silhouetteEl) silhouetteEl.textContent = dress.silhouette || 'Bridal Gown';
    if (titleEl) titleEl.textContent = dress.title;
    if (priceEl) priceEl.textContent = dress.price;
    if (sampleSizeEl) sampleSizeEl.textContent = `In-Store Sample Size ${dress.sampleSize || '14'}`;

    if (badge) {
      const isSample = (dress.category && dress.category.toLowerCase().includes('sample')) ||
                       (dress.price && dress.price.toLowerCase().includes('sample'));
      badge.textContent = isSample ? 'Sample Sale' : 'Made to Order';
      badge.className = isSample
        ? 'absolute top-4 left-4 z-20 bg-red-900/90 text-white text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 backdrop-blur-xs font-medium'
        : 'absolute top-4 left-4 z-20 bg-stone-900/85 text-white text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 backdrop-blur-xs font-medium';
    }

    if (bookBtn) {
      bookBtn.href = `/the-experience#book?dress=${encodeURIComponent(dress.title + ' by ' + dress.designer)}`;
    }

    if (galleryBar) {
      if (allImages.length > 1) {
        galleryBar.classList.remove('hidden');
        galleryBar.classList.add('flex');
        galleryBar.innerHTML = allImages.map((src, i) => `
          <button
            type="button"
            class="gallery-thumb w-8 h-10 border ${i === 0 ? 'border-white' : 'border-stone-500 opacity-60'} overflow-hidden cursor-pointer transition-all"
            data-src="${src}"
          >
            <img src="${src}" class="w-full h-full object-cover" />
          </button>
        `).join('');

        document.querySelectorAll('.gallery-thumb').forEach(btn => {
          btn.addEventListener('click', () => {
            const src = (btn as HTMLElement).dataset.src;
            if (src && mainImg) mainImg.src = src;
            document.querySelectorAll('.gallery-thumb').forEach(b => {
              b.classList.remove('border-white');
              b.classList.add('border-stone-500', 'opacity-60');
            });
            btn.classList.add('border-white');
            btn.classList.remove('border-stone-500', 'opacity-60');
          });
        });
      } else {
        galleryBar.classList.add('hidden');
        galleryBar.classList.remove('flex');
      }
    }

    syncLightboxWishlistBtn();

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      dialog?.classList.remove('scale-95');
      dialog?.classList.add('scale-100');
    });
  }

  function closeLightbox() {
    if (!modal) return;
    modal.classList.add('opacity-0');
    dialog?.classList.remove('scale-100');
    dialog?.classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      activeDress = null;
    }, 250);
  }

  function syncLightboxWishlistBtn() {
    if (!activeDress) return;
    const saved = JSON.parse(localStorage.getItem('tbr_wishlist') || '[]');
    const isSaved = saved.some((item: any) => item.id === activeDress.id);

    if (isSaved) {
      heartIcon?.classList.add('fill-red-700', 'text-red-700');
      heartIcon?.classList.remove('fill-none');
      if (wishlistText) wishlistText.textContent = 'Saved in Your Shortlist';
    } else {
      heartIcon?.classList.remove('fill-red-700', 'text-red-700');
      heartIcon?.classList.add('fill-none');
      if (wishlistText) wishlistText.textContent = 'Add to My Shortlist';
    }
  }

  wishlistBtn?.addEventListener('click', () => {
    if (!activeDress) return;
    let saved = JSON.parse(localStorage.getItem('tbr_wishlist') || '[]');
    const index = saved.findIndex((item: any) => item.id === activeDress.id);

    if (index > -1) {
      saved.splice(index, 1);
    } else {
      saved.push({
        id: activeDress.id,
        title: activeDress.title,
        designer: activeDress.designer,
        price: activeDress.price,
        image: activeDress.image,
        category: activeDress.category
      });
    }

    localStorage.setItem('tbr_wishlist', JSON.stringify(saved));
    window.dispatchEvent(new Event('wishlist-updated'));
    syncLightboxWishlistBtn();
  });

  closeBtn?.addEventListener('click', closeLightbox);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeLightbox();
    }
  });

  (window as any).tbrOpenDressLightbox = openLightbox;
</script>