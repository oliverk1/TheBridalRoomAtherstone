---
// src/components/ui/DressLightbox.astro
---

<div
  id="global-dress-lightbox"
  class="fixed inset-0 z-60 bg-stone-950/85 backdrop-blur-xs hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-3 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-label="Maximised Dress View"
>
  <div
    id="lightbox-dialog"
    class="relative w-full max-w-4xl bg-ivory-50 border border-stone-300 shadow-2xl scale-95 transition-transform duration-300 overflow-hidden flex flex-col md:flex-row max-h-[92vh] rounded-xs"
  >
    <!-- Close Button -->
    <button
      id="lightbox-close-btn"
      type="button"
      class="absolute top-3 right-3 z-30 w-9 h-9 rounded-full bg-white/90 backdrop-blur-xs flex items-center justify-center text-stone-800 hover:text-black hover:bg-white shadow-md cursor-pointer transition-transform hover:scale-105"
      aria-label="Close Maximised View"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>

    <!-- Left: Image Stage with Next/Previous Arrows & Gallery Thumbnails -->
    <div class="relative md:w-3/5 bg-stone-200 overflow-hidden flex flex-col items-center justify-between min-h-[340px] md:min-h-[580px] max-h-[52vh] md:max-h-[92vh]">
      
      <!-- Main Photo -->
      <div class="w-full h-full flex items-center justify-center overflow-hidden relative">
        <img
          id="lightbox-main-img"
          src=""
          alt="Maximised Wedding Dress"
          class="w-full h-full object-cover object-top transition-opacity duration-300"
        />

        <!-- Previous Photo Arrow -->
        <button
          id="lightbox-prev-arrow"
          type="button"
          class="absolute left-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/80 hover:bg-white text-stone-900 flex items-center justify-center shadow-md cursor-pointer opacity-0 hover:opacity-100 transition-opacity hidden"
          aria-label="Previous Photo"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>

        <!-- Next Photo Arrow -->
        <button
          id="lightbox-next-arrow"
          type="button"
          class="absolute right-2.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/80 hover:bg-white text-stone-900 flex items-center justify-center shadow-md cursor-pointer opacity-0 hover:opacity-100 transition-opacity hidden"
          aria-label="Next Photo"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>

      <!-- Category Pill -->
      <span id="lightbox-badge" class="absolute top-4 left-4 z-20 bg-stone-900/85 text-white text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 backdrop-blur-xs font-medium rounded-2xs">
        Made to Order
      </span>

      <!-- Multi-Image Thumbnail Gallery Bar -->
      <div id="lightbox-gallery-bar" class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 hidden items-center gap-2 bg-stone-900/80 backdrop-blur-xs px-3 py-1.5 rounded-full shadow-md max-w-[90%] overflow-x-auto">
      </div>
    </div>

    <!-- Right: Editorial Details -->
    <div class="md:w-2/5 p-6 sm:p-8 bg-white flex flex-col justify-between overflow-y-auto">
      <div>
        <div class="flex items-center justify-between mb-2 pr-12">
          <p id="lightbox-designer" class="text-[10px] tracking-[0.28em] uppercase text-stone-500 font-medium">Designer</p>
          <span id="lightbox-silhouette" class="text-[10px] tracking-wider uppercase text-stone-400 font-medium">Silhouette</span>
        </div>
        
        <h3 id="lightbox-title" class="font-serif text-2xl sm:text-3xl uppercase text-stone-900 font-light leading-snug mb-3 pr-8">
          Dress Title
        </h3>

        <div class="flex items-baseline gap-3 pb-3 mb-3 border-b border-stone-200">
          <span id="lightbox-price" class="font-serif text-xl text-sage-900 font-medium">£1,650</span>
          <span id="lightbox-sample-size" class="text-xs text-stone-500 font-light">Sample Size in Store</span>
        </div>

        <!-- SPECIAL FEATURES CHIP TRAY -->
        <div id="lightbox-features-box" class="mb-4 hidden">
          <span class="text-[9px] uppercase tracking-[0.15em] text-stone-400 font-medium block mb-1.5">Gown Features:</span>
          <div id="lightbox-features-list" class="flex flex-wrap gap-1.5"></div>
        </div>

        <!-- Custom Description from Decap CMS (Markdown-Supported Container) -->
        <div class="space-y-3 text-xs text-stone-600 font-light leading-relaxed mb-6">
          <div id="lightbox-desc" class="space-y-2 leading-relaxed text-stone-700 text-xs font-light">
            <p>Experience this gown in your own private boudoir styling suite at 65 Station Street, Atherstone.</p>
          </div>

          <ul class="space-y-1.5 text-[11px] text-stone-500 pt-3 border-t border-stone-100">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-800"></span>
              1-to-1 styling session with Vicky &amp; Sam
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-800"></span>
              Orderable in UK sizes 2 through 32
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-800"></span>
              In-house bespoke seamstress fittings
            </li>
          </ul>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 border-t border-stone-100 flex flex-col gap-2.5">
        <a
          id="lightbox-book-btn"
          href="/the-experience#book"
          class="w-full text-center bg-stone-900 text-white py-3.5 px-4 text-xs uppercase tracking-[0.2em] hover:bg-sage-800 transition-colors shadow-xs rounded-2xs"
        >
          Try This On in Boutique &rarr;
        </a>

        <button
          id="lightbox-wishlist-btn"
          type="button"
          class="w-full text-center border border-stone-300 py-3 px-4 text-xs uppercase tracking-[0.18em] text-stone-800 hover:border-stone-900 transition-colors cursor-pointer flex items-center justify-center gap-2 rounded-2xs"
        >
          <svg id="lightbox-heart-icon" class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
          <span id="lightbox-wishlist-text">Add to My Shortlist</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let activeDress: any = null;
  let activeImageIndex = 0;
  let currentGalleryImages: string[] = [];

  const modal = document.getElementById('global-dress-lightbox');
  const dialog = document.getElementById('lightbox-dialog');
  const closeBtn = document.getElementById('lightbox-close-btn');
  const mainImg = document.getElementById('lightbox-main-img') as HTMLImageElement;
  const prevArrow = document.getElementById('lightbox-prev-arrow');
  const nextArrow = document.getElementById('lightbox-next-arrow');
  const badge = document.getElementById('lightbox-badge');
  const designerEl = document.getElementById('lightbox-designer');
  const silhouetteEl = document.getElementById('lightbox-silhouette');
  const titleEl = document.getElementById('lightbox-title');
  const priceEl = document.getElementById('lightbox-price');
  const sampleSizeEl = document.getElementById('lightbox-sample-size');
  const descEl = document.getElementById('lightbox-desc');
  const featuresBox = document.getElementById('lightbox-features-box');
  const featuresList = document.getElementById('lightbox-features-list');
  const bookBtn = document.getElementById('lightbox-book-btn') as HTMLAnchorElement;
  const wishlistBtn = document.getElementById('lightbox-wishlist-btn');
  const heartIcon = document.getElementById('lightbox-heart-icon');
  const wishlistText = document.getElementById('lightbox-wishlist-text');
  const galleryBar = document.getElementById('lightbox-gallery-bar');

  // ==========================================
  // LIGHTWEIGHT ZERO-DEPENDENCY MARKDOWN PARSER
  // ==========================================
  function renderMarkdown(raw: string): string {
    if (!raw || !raw.trim()) {
      return '<p class="leading-relaxed">Experience this gown in your own private boudoir styling suite at 65 Station Street, Atherstone.</p>';
    }

    // 1. Normalize line breaks and escape raw HTML for safety
    let text = raw.trim().replace(/\r\n/g, '\n');
    text = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // 2. Headings (###, ##, #)
    text = text.replace(/^###\s+(.+)$/gm, '<h4 class="font-serif text-sm uppercase tracking-wider text-stone-900 font-medium mt-3 mb-1.5">$1</h4>');
    text = text.replace(/^##\s+(.+)$/gm, '<h3 class="font-serif text-base uppercase tracking-wider text-stone-900 font-medium mt-3 mb-1.5">$1</h3>');
    text = text.replace(/^#\s+(.+)$/gm, '<h2 class="font-serif text-lg uppercase tracking-wider text-stone-900 font-medium mt-4 mb-2">$1</h2>');

    // 3. Bold & Italic
    text = text.replace(/\*\*(.+?)\*\*/g, '<strong class="font-medium text-stone-900">$1</strong>');
    text = text.replace(/__(.+?)__/g, '<strong class="font-medium text-stone-900">$1</strong>');
    text = text.replace(/\*(.+?)\*/g, '<em class="italic">$1</em>');
    text = text.replace(/_(.+?)_/g, '<em class="italic">$1</em>');

    // 4. Links [text](url)
    text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-stone-900 underline underline-offset-2 hover:text-sage-900">$1</a>');

    // 5. Blockquotes (> quote)
    text = text.replace(/^&gt;\s+(.+)$/gm, '<blockquote class="border-l-2 border-sage-800 pl-3 italic text-stone-600 my-2">$1</blockquote>');

    // 6. Split by double newlines into blocks to handle lists and paragraphs
    const blocks = text.split(/\n\n+/);
    const htmlBlocks = blocks.map(block => {
      const trimmed = block.trim();
      if (!trimmed) return '';

      // Skip blocks that are already structural elements
      if (trimmed.startsWith('<h') || trimmed.startsWith('<blockquote')) {
        return trimmed;
      }

      const lines = trimmed.split('\n');

      // Unordered list: lines starting with -, *, or bullet
      const isBulletList = lines.every(line => /^[-*•]\s+/.test(line.trim()));
      if (isBulletList) {
        const items = lines.map(line => {
          const content = line.trim().replace(/^[-*•]\s+/, '');
          return `<li class="leading-relaxed">${content}</li>`;
        }).join('');
        return `<ul class="list-disc pl-4 space-y-1 my-2 marker:text-sage-800">${items}</ul>`;
      }

      // Ordered list: lines starting with 1., 2., etc.
      const isNumberedList = lines.every(line => /^\d+\.\s+/.test(line.trim()));
      if (isNumberedList) {
        const items = lines.map(line => {
          const content = line.trim().replace(/^\d+\.\s+/, '');
          return `<li class="leading-relaxed">${content}</li>`;
        }).join('');
        return `<ol class="list-decimal pl-4 space-y-1 my-2 marker:text-sage-800">${items}</ol>`;
      }

      // Standard Paragraph: convert internal single line breaks to <br />
      const withLineBreaks = lines.join('<br />');
      return `<p class="leading-relaxed mb-2">${withLineBreaks}</p>`;
    });

    return htmlBlocks.join('');
  }

  function setMainImageByIndex(idx: number) {
    if (!mainImg || currentGalleryImages.length === 0) return;
    activeImageIndex = (idx + currentGalleryImages.length) % currentGalleryImages.length;
    mainImg.src = currentGalleryImages[activeImageIndex];

    document.querySelectorAll('.gallery-thumb').forEach((thumb, i) => {
      if (i === activeImageIndex) {
        thumb.classList.add('border-white', 'opacity-100');
        thumb.classList.remove('border-stone-500', 'opacity-60');
      } else {
        thumb.classList.remove('border-white', 'opacity-100');
        thumb.classList.add('border-stone-500', 'opacity-60');
      }
    });
  }

  function openLightbox(dress: any) {
    if (!modal || !mainImg) return;
    activeDress = dress;
    activeImageIndex = 0;

    // 1. Populate Custom Description (Markdown Formatted)
    if (descEl) {
      descEl.innerHTML = renderMarkdown(dress.description);
    }

    // 2. Populate Special Features Badges
    if (featuresBox && featuresList) {
      const feats: string[] = Array.isArray(dress.features) ? dress.features : [];
      if (feats.length > 0) {
        featuresBox.classList.remove('hidden');
        featuresList.innerHTML = feats.map(f => `
          <span class="inline-block bg-sage-100 border border-sage-200 text-sage-900 text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-2xs font-medium">
            ${f}
          </span>
        `).join('');
      } else {
        featuresBox.classList.add('hidden');
        featuresList.innerHTML = '';
      }
    }

    // 3. Collect Images
    const allImages = [dress.image];
    if (dress.imageDetail && dress.imageDetail !== dress.image) {
      allImages.push(dress.imageDetail);
    }
    if (Array.isArray(dress.gallery)) {
      dress.gallery.forEach((g: string) => {
        if (g && !allImages.includes(g)) allImages.push(g);
      });
    }
    currentGalleryImages = allImages;

    setMainImageByIndex(0);
    mainImg.alt = `${dress.title} by ${dress.designer}`;

    if (designerEl) designerEl.textContent = dress.designer;
    if (silhouetteEl) {
      const necklineText = dress.neckline ? ` • ${dress.neckline}` : '';
      silhouetteEl.textContent = `${dress.silhouette || 'Bridal Gown'}${necklineText}`;
    }
    if (titleEl) titleEl.textContent = dress.title;
    if (priceEl) priceEl.textContent = dress.price;
    if (sampleSizeEl) sampleSizeEl.textContent = `In-Store Sample Size ${dress.sampleSize || '14'}`;

    if (badge) {
      const isSample = (dress.category && dress.category.toLowerCase().includes('sample')) ||
                       (dress.price && dress.price.toLowerCase().includes('sample'));
      badge.textContent = isSample ? 'Sample Sale' : 'Made to Order';
      badge.className = isSample
        ? 'absolute top-4 left-4 z-20 bg-red-900/90 text-white text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 backdrop-blur-xs font-medium rounded-2xs'
        : 'absolute top-4 left-4 z-20 bg-stone-900/85 text-white text-[9px] uppercase tracking-[0.2em] px-2.5 py-1 backdrop-blur-xs font-medium rounded-2xs';
    }

    if (bookBtn) {
      bookBtn.href = `/the-experience#book?dress=${encodeURIComponent(dress.title + ' by ' + dress.designer)}`;
    }

    if (currentGalleryImages.length > 1) {
      prevArrow?.classList.remove('hidden');
      nextArrow?.classList.remove('hidden');

      if (galleryBar) {
        galleryBar.classList.remove('hidden');
        galleryBar.classList.add('flex');
        galleryBar.innerHTML = currentGalleryImages.map((src, i) => `
          <button
            type="button"
            class="gallery-thumb w-8 h-10 border ${i === 0 ? 'border-white opacity-100' : 'border-stone-500 opacity-60'} overflow-hidden cursor-pointer transition-all shrink-0 rounded-2xs"
            data-index="${i}"
          >
            <img src="${src}" class="w-full h-full object-cover" />
          </button>
        `).join('');

        document.querySelectorAll('.gallery-thumb').forEach(thumb => {
          thumb.addEventListener('click', () => {
            const idx = Number((thumb as HTMLElement).dataset.index || 0);
            setMainImageByIndex(idx);
          });
        });
      }
    } else {
      prevArrow?.classList.add('hidden');
      nextArrow?.classList.add('hidden');
      galleryBar?.classList.add('hidden');
      galleryBar?.classList.remove('flex');
    }

    syncLightboxWishlistBtn();

    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      dialog?.classList.remove('scale-95');
      dialog?.classList.add('scale-100');
    });
  }

  prevArrow?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMainImageByIndex(activeImageIndex - 1);
  });

  nextArrow?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMainImageByIndex(activeImageIndex + 1);
  });

  function closeLightbox() {
    if (!modal) return;
    modal.classList.add('opacity-0');
    dialog?.classList.remove('scale-100');
    dialog?.classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      activeDress = null;
    }, 250);
  }

  function syncLightboxWishlistBtn() {
    if (!activeDress) return;
    const saved = JSON.parse(localStorage.getItem('tbr_wishlist') || '[]');
    const isSaved = saved.some((item: any) => item.id === activeDress.id);

    if (isSaved) {
      heartIcon?.classList.add('fill-red-700', 'text-red-700');
      heartIcon?.classList.remove('fill-none');
      if (wishlistText) wishlistText.textContent = 'Saved in Your Shortlist';
    } else {
      heartIcon?.classList.remove('fill-red-700', 'text-red-700');
      heartIcon?.classList.add('fill-none');
      if (wishlistText) wishlistText.textContent = 'Add to My Shortlist';
    }
  }

  wishlistBtn?.addEventListener('click', () => {
    if (!activeDress) return;
    let saved = JSON.parse(localStorage.getItem('tbr_wishlist') || '[]');
    const index = saved.findIndex((item: any) => item.id === activeDress.id);

    if (index > -1) {
      saved.splice(index, 1);
    } else {
      saved.push({
        id: activeDress.id,
        title: activeDress.title,
        designer: activeDress.designer,
        price: activeDress.price,
        image: activeDress.image,
        category: activeDress.category
      });
    }

    localStorage.setItem('tbr_wishlist', JSON.stringify(saved));
    window.dispatchEvent(new Event('wishlist-updated'));
    syncLightboxWishlistBtn();
  });

  closeBtn?.addEventListener('click', closeLightbox);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (modal && !modal.classList.contains('hidden')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') setMainImageByIndex(activeImageIndex - 1);
      if (e.key === 'ArrowRight') setMainImageByIndex(activeImageIndex + 1);
    }
  });

  (window as any).tbrOpenDressLightbox = openLightbox;
</script>