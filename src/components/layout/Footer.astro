---
// src/components/layout/Footer.astro
const PHONE_NUMBER = "01827 946 098";
const PHONE_HREF = "tel:01827946098";
---

<footer id="contact" class="bg-ivory-50 border-t border-stone-200 pt-16 pb-12 px-6 lg:px-12">
  <div class="max-w-6xl mx-auto">
    
    <!-- Centered Brand Identity -->
    <div class="text-center mb-14">
      <h3 class="font-serif text-2xl sm:text-3xl tracking-[0.25em] text-stone-900 uppercase font-light">
        The Bridal Room
      </h3>
      <div class="flex items-center justify-center gap-3 mt-1.5 text-[10px] tracking-[0.35em] text-stone-600 uppercase font-light">
        <span class="w-8 h-px bg-stone-300"></span>
        Atherstone &bull; Warwickshire
        <span class="w-8 h-px bg-stone-300"></span>
      </div>
      <p class="text-xs text-stone-500 font-light mt-2 tracking-wider">
        Private Bridal Suites &bull; Made to Order & Sample Collections
      </p>
    </div>

    <!-- 4-Column Local Information Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 pb-12 border-b border-stone-200 text-xs text-stone-600">
      
      <!-- Col 1: Boutique Address & Phone -->
      <div>
        <h4 class="tracking-[0.2em] uppercase text-stone-900 font-medium mb-4 text-[11px]">
          Visit The Boutique
        </h4>
        <address class="not-italic leading-relaxed font-light text-stone-500 mb-4">
          65 Station Street<br />
          Atherstone<br />
          Warwickshire<br />
          CV9 1DB
        </address>
        <p class="font-light text-stone-600">
          Tel: <a href={PHONE_HREF} class="hover:text-stone-950 font-normal underline underline-offset-2">{PHONE_NUMBER}</a>
        </p>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h4 class="tracking-[0.2em] uppercase text-stone-900 font-medium mb-4 text-[11px]">
          Pillars
        </h4>
        <ul class="space-y-2.5 font-light">
          <li><a href="/" class="hover:text-stone-950 transition-colors">Showroom Home</a></li>
          <li><a href="/dresses" class="hover:text-stone-950 transition-colors">The Dress Lookbook</a></li>
          <li><a href="/the-experience" class="hover:text-stone-950 transition-colors">The 1-to-1 Experience</a></li>
          <li><a href="/about" class="hover:text-stone-950 transition-colors">About Vicky & Sam</a></li>
          <li><a href="/contact" class="hover:text-stone-950 transition-colors">Parking & Directions</a></li>
        </ul>
      </div>

      <!-- Col 3: Hours & Car Park Info -->
      <div>
        <h4 class="tracking-[0.2em] uppercase text-stone-900 font-medium mb-4 text-[11px]">
          Fittings & Parking
        </h4>
        <ul class="space-y-1.5 font-light text-stone-500 text-[11px] mb-3">
          <li class="flex justify-between"><span>Mon, Tue, Thu–Sat:</span> <span>9:30am – 5:30pm</span></li>
          <li class="flex justify-between font-medium text-stone-700"><span>Wednesday Late Night:</span> <span>Until 9:00pm</span></li>
          <li class="flex justify-between"><span>Sunday:</span> <span>Special Request</span></li>
        </ul>
        <p class="font-light text-stone-500 text-[11px] leading-relaxed">
          <strong>Free 2-Hour Parking:</strong> Cattle Market Car Park (1-min walk, RingGo code <span class="font-mono text-stone-800">3611082</span>).
        </p>
      </div>

      <!-- Col 4: Social Proof & Instagram -->
      <div>
        <h4 class="tracking-[0.2em] uppercase text-stone-900 font-medium mb-4 text-[11px]">
          Follow Real Brides
        </h4>
        <p class="font-light text-stone-500 mb-4 leading-relaxed">
          Tag <strong class="font-normal text-stone-800">#TBRBride</strong> to be featured on our boutique journal.
        </p>
        <div class="flex items-center gap-2.5 text-stone-700">
          <a
            href="https://www.instagram.com/thebridalroomatherstone"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-stone-300 flex items-center justify-center hover:border-stone-800 hover:text-stone-950 transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a
            href="https://www.facebook.com/thebridalroomatherstone"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 border border-stone-300 flex items-center justify-center hover:border-stone-800 hover:text-stone-950 transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-stone-500 font-light">
      <p>© 2026 The Bridal Room Atherstone. Hand-crafted in Warwickshire.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-stone-800 transition-colors">Privacy Notice</a>
        <span>&bull;</span>
        <a href="/terms" class="hover:text-stone-800 transition-colors">Boutique Terms</a>
        <span>&bull;</span>
        <a href="/admin/" class="hover:text-stone-800 transition-colors text-stone-400">Admin Login</a>
      </div>
    </div>

  </div>
</footer>