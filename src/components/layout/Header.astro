---
// src/components/layout/Header.astro
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'The Dresses', href: '/dresses' },
  { label: 'The Experience', href: '/the-experience' },
  { label: 'About Us', href: '/about' },
  { label: 'Contact & Visit', href: '/contact' },
];

const PHONE_DISPLAY = "01827 946 098";
const PHONE_HREF = "tel:01827946098";
---

<header class="sticky top-0 z-40 bg-sage-100/95 backdrop-blur-md border-b border-sage-200 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-12 py-3 lg:py-4">
    
    <!-- Boutique Brand Heading -->
    <div class="text-center mb-2.5 lg:mb-3.5">
      <a href="/" class="inline-block group">
        <span class="font-serif text-xl sm:text-2xl md:text-3xl tracking-[0.25em] text-stone-800 uppercase font-light group-hover:text-stone-950 transition-colors block">
          The Bridal Room
        </span>
        <div class="flex items-center justify-center gap-3 mt-1 text-[9px] sm:text-[10px] tracking-[0.35em] text-stone-600 uppercase font-light">
          <span class="w-6 sm:w-8 h-px bg-stone-400"></span>
          Atherstone
          <span class="w-6 sm:w-8 h-px bg-stone-400"></span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation Bar -->
    <nav class="hidden lg:flex items-center justify-center gap-8 text-xs tracking-[0.18em] uppercase text-stone-700">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`transition-colors py-1 ${isActive ? 'text-sage-800 font-medium border-b border-sage-800' : 'hover:text-stone-950'}`}
          >
            {item.label}
          </a>
        );
      })}

      <!-- Wishlist Counter Trigger Button -->
      <button
        id="wishlist-trigger-desktop"
        class="relative flex items-center gap-1.5 ml-2 text-stone-700 hover:text-stone-950 cursor-pointer"
        aria-label="Open Saved Bride Favourites"
      >
        <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
        </svg>
        <span class="text-[10px] tracking-widest uppercase font-medium">Shortlist</span>
        <span id="wishlist-badge-desktop" class="hidden text-[10px] bg-sage-800 text-white rounded-full px-1.5 py-0.2">0</span>
      </button>

      <!-- Primary Booking CTA -->
      <a
        href="/the-experience#book"
        class="border border-stone-600 px-5 py-2 hover:bg-stone-800 hover:text-white transition-all duration-300 ml-2"
      >
        Book Appointment
      </a>
    </nav>

    <!-- Mobile Navigation Top Bar -->
    <div class="flex lg:hidden items-center justify-between pt-1">
      <a
        href="/the-experience#book"
        class="text-[10px] uppercase tracking-[0.2em] border border-stone-700 px-3 py-1.5 text-stone-800 hover:bg-stone-800 hover:text-white transition-colors"
      >
        Book
      </a>

      <div class="flex items-center gap-3">
        <!-- Mobile Wishlist Button -->
        <button
          id="wishlist-trigger-mobile"
          class="relative p-2 text-stone-800"
          aria-label="Open Saved Bride Favourites"
        >
          <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
          </svg>
          <span id="wishlist-badge-mobile" class="hidden absolute top-1 right-0 text-[9px] bg-sage-800 text-white rounded-full px-1.2 py-0">0</span>
        </button>

        <!-- Hamburger Icon -->
        <button
          id="mobile-menu-btn"
          aria-label="Toggle navigation menu"
          class="p-2 text-stone-800 focus:outline-none"
        >
          <svg id="icon-bars" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Collapsible Menu -->
    <div
      id="mobile-menu-panel"
      class="hidden lg:hidden flex flex-col gap-4 pt-5 pb-3 text-center text-xs tracking-[0.2em] uppercase border-t border-sage-200 mt-3"
    >
      {navItems.map((item) => (
        <a href={item.href} class="py-2 hover:text-stone-500">{item.label}</a>
      ))}
      <a href={PHONE_HREF} class="py-2 text-stone-900 font-medium">Direct Tel: {PHONE_DISPLAY}</a>
    </div>

  </div>
</header>

<script>
  // Mobile Menu Toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuPanel = document.getElementById('mobile-menu-panel');
  const iconBars = document.getElementById('icon-bars');
  const iconClose = document.getElementById('icon-close');

  menuBtn?.addEventListener('click', () => {
    const isHidden = menuPanel?.classList.toggle('hidden');
    iconBars?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', isHidden);
  });

  // Global Wishlist Count Listener
  function refreshWishlistBadges() {
    const saved = JSON.parse(localStorage.getItem('tbr_wishlist') || '[]');
    const count = saved.length;
    const desktopBadge = document.getElementById('wishlist-badge-desktop');
    const mobileBadge = document.getElementById('wishlist-badge-mobile');

    [desktopBadge, mobileBadge].forEach(badge => {
      if (!badge) return;
      if (count > 0) {
        badge.textContent = String(count);
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    });
  }

  window.addEventListener('storage', refreshWishlistBadges);
  window.addEventListener('wishlist-updated', refreshWishlistBadges);
  document.addEventListener('DOMContentLoaded', refreshWishlistBadges);
</script>