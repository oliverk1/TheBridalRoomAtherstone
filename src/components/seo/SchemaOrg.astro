---
// src/components/seo/SchemaOrg.astro
interface Props {
  faqs?: Array<{ question: string; answer: string }>;
}

const { faqs = [] } = Astro.props;

const siteUrl = "https://thebridalroomatherstone.co.uk";
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '';
const canonicalUrl = `${siteUrl}${currentPath}`;

// 1. Local Business / Bridal Store Graph
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "BridalStore",
  "@id": `${siteUrl}/#business`,
  "name": "The Bridal Room Atherstone",
  "url": siteUrl,
  "logo": `${siteUrl}/images/boutique.webp`,
  "image": `${siteUrl}/images/og-image.jpg`,
  "telephone": "+441827946098",
  "priceRange": "££ - £££",
  "currenciesAccepted": "GBP",
  "paymentAccepted": "Cash, Credit Card, Debit Card",
  "description": "Exclusive private bridal appointments, made-to-order designer wedding dresses (£1,200–£2,500) and sample sale gowns in Atherstone, Warwickshire.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "65 Station Street",
    "addressLocality": "Atherstone",
    "addressRegion": "Warwickshire",
    "postalCode": "CV9 1DB",
    "addressCountry": "GB"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 52.5746,
    "longitude": -1.5463
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:30",
      "closes": "17:30"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Wednesday"],
      "opens": "09:30",
      "closes": "21:00"
    }
  ],
  "founder": [
    {
      "@type": "Person",
      "name": "Vicky",
      "jobTitle": "Master Bridal Stylist & Founder",
      "description": "29+ years fashion retail experience across clothing, lingerie, shoes, and jewellery, 15 years in bridal, and former wedding photographer."
    },
    {
      "@type": "Person",
      "name": "Samantha",
      "jobTitle": "Bridal Stylist & Trend Curator",
      "description": "Fashion & Design graduate with expertise in bridal trend forecasting and silhouette curation."
    }
  ],
};

// 2. Google BreadcrumbList Schema (Shows clean search hierarchy)
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": siteUrl
  }
];

if (currentPath === '/the-experience') {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": "The Experience & Booking",
    "item": `${siteUrl}/the-experience`
  });
} else if (currentPath === '/dresses') {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": "The Dresses",
    "item": `${siteUrl}/dresses`
  });
} else if (currentPath === '/about') {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": "About Us",
    "item": `${siteUrl}/about`
  });
} else if (currentPath === '/contact') {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": "Contact & Visit",
    "item": `${siteUrl}/contact`
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

// 3. FAQPage Schema for Rich Search Snippets
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}