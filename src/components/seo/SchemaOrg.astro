---
interface Props {
  faqs?: Array<{ question: string; answer: string }>;
}

const { faqs = [] } = Astro.props;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "BridalStore",
  "@id": "https://thebridalroomatherstone.co.uk/#business",
  "name": "The Bridal Room Atherstone",
  "url": "https://thebridalroomatherstone.co.uk",
  "logo": "https://thebridalroomatherstone.co.uk/images/logo.png",
  "image": "https://thebridalroomatherstone.co.uk/images/boutique.webp",
  "telephone": "+441827946098",
  "priceRange": "££ - £££",
  "description": "Exclusive private bridal appointments, made-to-order designer wedding dresses (£1,200–£2,500) and sample sale gowns in Atherstone, Warwickshire.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "65 Station Street",
    "addressLocality": "Atherstone",
    "addressRegion": "Warwickshire",
    "postalCode": "CV9 1DB",
    "addressCountry": "GB"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 52.5746,
    "longitude": -1.5463
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Warwickshire" },
    { "@type": "AdministrativeArea", "name": "West Midlands" },
    { "@type": "City", "name": "Atherstone" },
    { "@type": "City", "name": "Tamworth" },
    { "@type": "City", "name": "Nuneaton" },
    { "@type": "City", "name": "Coventry" },
    { "@type": "City", "name": "Birmingham" }
  ],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:30",
      "closes": "17:30"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Wednesday"],
      "opens": "09:30",
      "closes": "21:00"
    }
  ]
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}