---
interface Props {
  title?: string;
  description?: string;
  canonicalURL?: URL | string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = "The Bridal Room | Luxury Bridal Boutique Atherstone, Warwickshire",
  description = "The Bridal Room Atherstone is an intimate Warwickshire bridal boutique offering exclusive private appointments, Made to Order gowns £1,200–£2,500, and designer sample sales.",
  canonicalURL = Astro.url.href,
  image = "/images/hero.webp",
  type = "website"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : "https://thebridalroomatherstone.co.uk";
const fullImageURL = new URL(image, siteUrl).href;
---

<!-- Core Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow, max-image-preview:large" />

<!-- Geo & Local SEO Signals -->
<meta name="geo.region" content="GB-WAR" />
<meta name="geo.placename" content="Atherstone" />
<meta name="geo.position" content="52.5746;-1.5463" />
<meta name="ICBM" content="52.5746, -1.5463" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="The Bridal Room Atherstone" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
<meta property="og:locale" content="en_GB" />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageURL} />

<!-- Favicon & Touch Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />